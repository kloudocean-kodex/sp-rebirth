{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sp-rebirth",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
  },
  // The default Worker is the production target. Its Queue producer/consumer
  // resources are provisioned in the authenticated account and deliberately
  // use different names from staging. Runtime secrets remain in Worker/GitHub
  // secret stores and are never committed here.
  "queues": {
    "producers": [
      {
        "binding": "LEAD_QUEUE",
        "queue": "sp-rebirth-production-leads",
      },
    ],
    "consumers": [
      {
        "queue": "sp-rebirth-production-leads",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "retry_delay": 15,
        "max_concurrency": 1,
        "dead_letter_queue": "sp-rebirth-production-leads-dlq",
      },
    ],
  },
  "observability": {
    "enabled": true,
  },

  // The production/default Worker uses the separately provisioned production
  // Queue. The isolated staging Worker below has its own Queue and DLQ.
  "env": {
    "staging": {
      "name": "sp-rebirth-staging",
      "workers_dev": true,
      "vars": {
        "PUBLIC_DEPLOY_ENV": "staging",
        "PUBLIC_SITE_URL": "https://sp-rebirth-staging.rajputrupali138.workers.dev",
        "LEAD_DELIVERY_MODE": "queue",
      },
      "queues": {
        "producers": [
          {
            "binding": "LEAD_QUEUE",
            "queue": "sp-rebirth-staging-leads",
          },
        ],
        "consumers": [
          {
            "queue": "sp-rebirth-staging-leads",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "retry_delay": 15,
            "max_concurrency": 1,
            "dead_letter_queue": "sp-rebirth-staging-leads-dlq",
          },
        ],
      },
    },
  },
}
