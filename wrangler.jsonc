{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sp-rebirth",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
  },
}
