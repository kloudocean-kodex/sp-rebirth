# Deployment safety: staging is noindex by default. Set to production only at approved cutover.
PUBLIC_DEPLOY_ENV=staging

# Public site identity
PUBLIC_SITE_URL=https://staging.example.workers.dev

# Sanity frontend public configuration
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_STUDIO_URL=https://your-studio.sanity.studio

# Sanity server-only draft token (Viewer role; never expose as PUBLIC_*)
SANITY_API_READ_TOKEN=

# Sanity Studio workspace (studio/.env in local development)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_PREVIEW_URL=http://localhost:4321
SANITY_STUDIO_APP_ID=

# Cloudflare Turnstile
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Lead transport.
# Staging defaults to webhook for integration work. Set this to queue only after the
# staging Queue + DLQ bindings have been provisioned and verified. Production builds
# are queue-only in application code regardless of this value.
LEAD_DELIVERY_MODE=webhook

# Downstream lead destination used directly in webhook staging mode and by the Queue
# consumer in durable queue mode. Endpoint must be HTTPS and accept JSON authenticated
# with Bearer LEAD_DELIVERY_TOKEN. The stable lead ID is also sent as Idempotency-Key.
LEAD_DELIVERY_WEBHOOK_URL=
LEAD_DELIVERY_TOKEN=

# LEAD_QUEUE is a Cloudflare Queue binding, not a text environment variable/secret.
# Declare the verified staging/production queue and DLQ in wrangler.jsonc only after
# those resources exist in the intended Cloudflare account.

# Optional analytics IDs. Do not load analytics until the measurement/privacy plan is approved.
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_GTM_CONTAINER_ID=
