# Public site identity
PUBLIC_SITE_URL=https://staging.example.workers.dev

# Sanity public configuration
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_VISUAL_EDITING_ENABLED=false

# Sanity server-only draft token (never expose as PUBLIC_*)
SANITY_API_READ_TOKEN=

# Cloudflare Turnstile
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Lead delivery: configure before enabling production forms.
# The endpoint should accept JSON and authenticate with Bearer LEAD_DELIVERY_TOKEN.
LEAD_DELIVERY_WEBHOOK_URL=
LEAD_DELIVERY_TOKEN=

# Optional analytics IDs; load only after consent strategy is approved.
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_GTM_CONTAINER_ID=
