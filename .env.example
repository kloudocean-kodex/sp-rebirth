# Public site identity
PUBLIC_SITE_URL=https://staging.example.workers.dev

# Sanity frontend public configuration
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_STUDIO_URL=https://your-studio.sanity.studio

# Sanity server-only draft token (Viewer role; never expose as PUBLIC_*)
SANITY_API_READ_TOKEN=

# Sanity Studio workspace (studio/.env in local development)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_PREVIEW_URL=http://localhost:4321
SANITY_STUDIO_APP_ID=

# Cloudflare Turnstile
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Lead delivery: configure before enabling production forms.
# The endpoint must accept JSON and authenticate with Bearer LEAD_DELIVERY_TOKEN.
LEAD_DELIVERY_WEBHOOK_URL=
LEAD_DELIVERY_TOKEN=

# Optional analytics IDs. Do not load analytics until the measurement/privacy plan is approved.
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_GTM_CONTAINER_ID=
