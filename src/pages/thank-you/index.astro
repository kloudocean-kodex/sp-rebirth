---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';

export const prerender = false;

const type = Astro.url.searchParams.get('type');
type ThankYouContent = { title: string; body: string };
const generalContent: ThankYouContent = {
  title: 'Thanks — your enquiry has been received securely.',
  body: 'Your details are being routed to Sana so she has the context you provided when she follows up.',
};
const labels: Record<string, ThankYouContent> = {
  rental_appraisal: {
    title: 'Your rental appraisal request has been received securely.',
    body: 'Your property details are being routed to Sana so she can review the context before following up.',
  },
  switch_manager: {
    title: 'Your switching enquiry has been received securely.',
    body: 'Your details are being routed to Sana so she has the context you provided when discussing the practical next step.',
  },
  general: generalContent,
};
const content: ThankYouContent = labels[type || ''] ?? generalContent;
---
<BaseLayout
  title="Thank You | Sana Patel Real Estate"
  description="Your enquiry has been received securely and is being routed to Sana Patel Real Estate."
  canonicalPath="/thank-you/"
  noindex={true}
>
  <SiteHeader slot="header" />
  <section class="thanks">
    <div class="container thanks__content">
      <p class="eyebrow">Enquiry received</p>
      <h1>{content.title}</h1>
      <p>{content.body}</p>
      <div class="thanks__actions">
        <a class="button button--solid" href="/">Return home</a>
        <a class="button" href="tel:+61416977990">Call 0416 977 990</a>
      </div>
    </div>
  </section>
  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .thanks { min-height:72svh; display:grid; align-items:center; padding-top:7rem; background:var(--paper); }
  .thanks__content { max-width:60rem; padding-block:var(--space-6); }
  h1 { margin-top:var(--space-2); max-width:12ch; font-size:var(--h1); }
  .thanks__content > p:last-of-type { margin-top:var(--space-3); max-width:40rem; color:var(--ink-soft); font-size:var(--body-lg); }
  .thanks__actions { margin-top:var(--space-4); display:flex; flex-wrap:wrap; gap:.8rem; }
</style>
