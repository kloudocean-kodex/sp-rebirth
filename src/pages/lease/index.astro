---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import InnerHero from '@/components/InnerHero.astro';

const title = 'Lease Property Melbourne | Rental Providers & Renters | Sana Patel Real Estate';
const description =
  'Choose the rental journey that matches you: Melbourne property management for rental providers or practical support for renters through Sana Patel Real Estate.';
---

<BaseLayout {title} {description} canonicalPath="/lease/">
  <SiteHeader slot="header" />
  <InnerHero
    eyebrow="Lease · Melbourne"
    title="One rental relationship. Two very different needs."
    lead="Rental providers need protection, performance and accountability. Renters need clear communication and a well-managed tenancy. Choose the path that matches you."
    image="https://www.sanapatel.com.au/wp-content/uploads/2025/07/lease-banner_2292016801.webp"
  />

  <section class="section">
    <div class="container-wide pathway-grid">
      <article>
        <p class="eyebrow">I own an investment property</p>
        <h2>For Rental Providers</h2>
        <p>
          Property management, rental appraisal, leasing, inspections, maintenance, arrears, renewals and direct
          accountability.
        </p>
        <div class="actions">
          <a class="button button--solid" href="/rental-providers/">Explore property management</a>
          <a class="button" href="/rental-appraisal/">Rental appraisal</a>
        </div>
      </article>
      <article>
        <p class="eyebrow">I rent or want to rent a home</p>
        <h2>For Renters</h2>
        <p>
          Find the renter pathway, understand how to contact Sana and access the practical information currently
          available for managed tenancies.
        </p>
        <div class="actions">
          <a class="button button--solid" href="/for-renters/">For renters</a>
          <a class="button" href="/contact/">Contact Sana</a>
        </div>
      </article>
    </div>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .pathway-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }
  article {
    min-height: 30rem;
    padding: clamp(2rem, 5vw, 5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--white);
    box-shadow: var(--shadow-soft);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  h2 {
    margin-top: var(--space-2);
    font-size: var(--h2);
  }
  article > p:not(.eyebrow) {
    margin-top: var(--space-2);
    max-width: 34rem;
    color: var(--ink-soft);
  }
  .actions {
    margin-top: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }
  @media (max-width: 800px) {
    .pathway-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
