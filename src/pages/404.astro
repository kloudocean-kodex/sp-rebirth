---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
---
<BaseLayout
  title="Page Not Found | Sana Patel Real Estate"
  description="The page you requested could not be found."
  canonicalPath="/404/"
  noindex={true}
>
  <SiteHeader slot="header" />
  <section class="not-found">
    <div class="container not-found__inner">
      <p class="eyebrow">404 · Page not found</p>
      <h1>This address doesn't lead anywhere useful.</h1>
      <p>The page may have moved during SP_REBIRTH. Use one of the paths below rather than being left at a dead end.</p>
      <div class="not-found__actions">
        <a class="button button--solid" href="/">Home</a>
        <a class="button" href="/rental-providers/">Rental Providers</a>
        <a class="button" href="/rental-appraisal/">Rental Appraisal</a>
        <a class="button" href="/contact/">Contact Sana</a>
      </div>
    </div>
  </section>
  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .not-found { min-height:75svh; display:grid; align-items:center; padding-top:7rem; background:var(--paper); }
  .not-found__inner { padding-block:var(--space-6); }
  h1 { margin-top:var(--space-2); max-width:11ch; font-size:var(--h1); }
  .not-found__inner > p:last-of-type { margin-top:var(--space-3); max-width:42rem; color:var(--ink-soft); font-size:var(--body-lg); }
  .not-found__actions { margin-top:var(--space-4); display:flex; flex-wrap:wrap; gap:.8rem; }
</style>
