      display: grid;
      grid-template-columns: 1fr 1fr;
      padding-block: 1rem;
      text-align: center;
    }
    .rebirth-hero__rail i { display: none; }
    .rebirth-choice__grid,
    .rebirth-services__grid {
      grid-template-columns: 1fr;
    }
    .rebirth-choice__card {
      min-height: 20rem;
      border-right: 0;
      border-bottom: 1px solid rgba(23, 23, 19, 0.13);
    }
    .rebirth-manifesto__index {
      writing-mode: initial;
