    .rebirth-proof-intro__grid,
    .rebirth-faq__grid,
    .rebirth-appraisal__grid {
      grid-template-columns: 1fr;
    }
    .rebirth-hero__grid {
      min-height: auto;
      padding-top: 7rem;
    }
    .rebirth-hero h1 {
      max-width: 9.5ch;
      font-size: clamp(4rem, 15vw, 6.2rem);
    }
    .rebirth-identity {
      min-height: 32rem;
      margin-top: 1rem;
    }
    .rebirth-identity__arch {
      width: min(22rem, 70%);
