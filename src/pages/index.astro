    .rebirth-founder__copy { order: 1; }
    .rebirth-services__intro > p:last-child { grid-column: auto; }
    .rebirth-switch__compare {
      margin-top: 1rem;
    }
    .rebirth-faq__intro {
      position: static;
    }
    .rebirth-appraisal__form {
      margin-top: 1rem;
    }
  }

  @media (max-width: 590px) {
    .rebirth-hero__actions,
    .rebirth-founder__actions {
      display: grid;
      grid-template-columns: 1fr;
    }
    .rebirth-button { width: 100%; }
    .rebirth-hero__credentials {
