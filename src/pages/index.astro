---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import TrustProof from '@/components/TrustProof.astro';
import { SITE } from '@/config/site';
import '@/styles/home-cinematic.css';

const title = 'Property Management Melbourne | Sana Patel Real Estate';
const description =
  'Melbourne property management for rental providers, delivered with strategy, accountability, personal attention and Sana Patel’s PRIDE service standard.';

const businessId = new URL('/#business', SITE.url).toString();
const founderId = new URL('/about/#sana-patel', SITE.url).toString();
const websiteId = new URL('/#website', SITE.url).toString();

const pride = [
  { letter: 'P', title: 'Proactive Property Care' },
  { letter: 'R', title: 'Responsive Communication' },
  { letter: 'I', title: 'Integrity in Every Decision' },
  { letter: 'D', title: 'Diligent Property Management' },
  { letter: 'E', title: 'Experience That Matters' },
] as const;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': websiteId,
    name: SITE.name,
    url: SITE.url,
    publisher: { '@id': businessId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'RealEstateAgent',
    '@id': businessId,
    name: SITE.name,
    url: SITE.url,
    telephone: SITE.phone.schema,
    email: SITE.email,
    areaServed: SITE.areaServed,
    logo: { '@type': 'ImageObject', url: SITE.logo },
    sameAs: [...SITE.profiles.business],
    founder: {
      '@type': 'Person',
      '@id': founderId,
      name: SITE.founder.name,
      jobTitle: 'Managing Director / Licensed Estate Agent',
      url: SITE.founder.profileUrl,
      sameAs: [...SITE.profiles.founder],
    },
  },
];
---

<BaseLayout {title} {description} canonicalPath="/" {schema} bodyClass="home-final">
  <SiteHeader slot="header" />

  <section class="sana-hero" id="top" aria-labelledby="hero-title">
    <div class="sana-hero__media" aria-hidden="true">
      <video
        class="sana-hero__video"
        muted
        playsinline
        loop
        preload="none"
        tabindex="-1"
        data-sana-hero-video
        data-src="/media/melbourne-brighton-drone-pexels-38304339-540p.mp4"
        data-src-low="/media/melbourne-brighton-drone-pexels-38304339-360p.mp4"></video>
    </div>
    <div class="container-wide sana-hero__inner">
      <p class="sana-overline">Melbourne Property Management · For Rental Providers.</p>
      <h1 id="hero-title">Is your property really being managed?</h1>
      <p class="sana-hero__lead">Property management with strategy, accountability and personal attention.</p>
      <p class="sana-signature">Your Property. My Priority.</p>
      <div class="sana-actions" aria-label="Property management next steps">
        <a class="sana-button sana-button--gold" href="/property-management-visibility-check/">
          Get a Rental Health Check
        </a>
        <a class="sana-button sana-button--outline" href="/switch-property-managers/">Change Property Manager</a>
      </div>
    </div>
  </section>

  <section class="sana-pride" id="pride" aria-labelledby="pride-title">
    <div class="container-wide">
      <header class="sana-section-head">
        <p class="sana-overline sana-overline--dark">The standard behind the service</p>
        <h2 id="pride-title">Property Management with <em>PRIDE.</em></h2>
        <p class="sana-section-head__lead">A clear standard for how I approach the management of every property.</p>
      </header>

      <div class="sana-pride__cards" aria-label="Sana Patel PRIDE service standard">
        {
          pride.map((item) => (
            <article class="sana-pride-card">
              <span class="sana-pride-card__letter" aria-hidden="true">
                {item.letter}
              </span>
              <h3>{item.title}</h3>
            </article>
          ))
        }
      </div>

      <div class="sana-pride__statement">
        <p>PRIDE is the standard I choose to bring to my work every day.</p>
      </div>

      <div class="sana-philosophy" id="why-sana">
        <div class="sana-philosophy__copy">
          <p class="sana-overline sana-overline--dark">What PRIDE means to me</p>
          <h2>Professional attention, even when the situation cannot be predicted.</h2>
          <p>
            For me, property management is not simply about collecting rent or completing routine tasks. It is about
            being prepared, communicating clearly, keeping accurate records, providing considered advice and giving each
            property the professional attention it deserves.
          </p>
          <p>
            I also understand that not every situation in property management can be predicted or controlled. What I can
            control is how I respond, how clearly I communicate, how carefully I document, and the professional standard
            I bring to the decisions within my role.
          </p>
        </div>
        <aside class="sana-philosophy__quote" aria-label="Sana Patel service philosophy">
          <span aria-hidden="true">“</span>
          <blockquote>What I can control is how I respond.</blockquote>
          <p>Sana Patel · Managing Director / Licensed Estate Agent</p>
        </aside>
      </div>

      <div class="sana-standard">
        <p class="sana-standard__label">The Standard behind the service</p>
        <p class="sana-standard__line">
          Different properties. Different situations. One consistent standard: <strong>PRIDE</strong>
        </p>
        <p class="sana-signature sana-signature--dark">Your Property. My Priority.</p>
      </div>
    </div>
  </section>

  <div id="reviews" class="sana-reviews">
    <TrustProof />
    <section class="sana-final-cta" aria-labelledby="final-cta-title">
      <div class="container-wide sana-final-cta__inner">
        <p class="sana-overline">Your next step</p>
        <h2 id="final-cta-title">Ready to take a closer look at how your property is being managed?</h2>
        <div class="sana-actions">
          <a class="sana-button sana-button--gold" href="/property-management-visibility-check/">
            Get a Rental Health Check
          </a>
          <a class="sana-button sana-button--outline" href="/switch-property-managers/">Change Property Manager</a>
        </div>
        <p class="sana-signature">Your Property. My Priority.</p>
      </div>
    </section>
  </div>

  <SiteFooter slot="footer" />
</BaseLayout>

<script is:inline>
  (() => {
    const video = document.querySelector('[data-sana-hero-video]');
    if (!(video instanceof HTMLVideoElement)) return;

    const motionAllowed = window.matchMedia('(min-width: 900px) and (prefers-reduced-motion: no-preference)');
    if (!motionAllowed.matches) return;

    const source = window.innerWidth >= 1280 ? video.dataset.src : video.dataset.srcLow;
    if (!source) return;

    const loadVideo = () => {
      video.src = source;
      video.addEventListener(
        'canplay',
        () => {
          video.closest('.sana-hero__media')?.classList.add('is-ready');
          void video.play().catch(() => undefined);
        },
        { once: true },
      );
      video.load();
    };

    video.addEventListener('timeupdate', () => {
      if (video.currentTime >= 9.5) {
        video.currentTime = 0;
        void video.play().catch(() => undefined);
      }
    });

    if (document.readyState === 'complete') {
      loadVideo();
    } else {
      window.addEventListener('load', loadVideo, { once: true });
    }
  })();
</script>
