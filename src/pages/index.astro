  @media (max-width: 1100px) {
    .rebirth-hero__grid,
    .rebirth-founder__grid,
    .rebirth-switch__grid,
    .rebirth-appraisal__grid {
      grid-template-columns: 1fr 0.86fr;
      gap: 3rem;
