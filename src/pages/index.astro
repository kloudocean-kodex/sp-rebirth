---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';

const title = 'Property Management Melbourne | Sana Patel Real Estate';
const description =
  'Founder-led Melbourne property management with direct access to Sana Patel, practical oversight and clear communication.';

const pride = [
  { letter: 'P', word: 'Passionate', line: 'Genuine care for the property, the client and the outcome.' },
  { letter: 'R', word: 'Results Driven', line: 'Focused on decisions, follow-through and what happens next.' },
  { letter: 'I', word: 'Integrity', line: 'Clear advice, transparency and personal accountability.' },
  { letter: 'D', word: 'Dedicated', line: 'Responsive, dependable and personally involved.' },
  { letter: 'E', word: 'Experienced', line: 'Property management grounded in practical experience.' },
] as const;

const service = [
  'Leasing & renter selection',
  'Rent reviews & tenancy planning',
  'Routine inspections',
  'Maintenance coordination',
  'Rent, arrears & renewals',
  'Direct owner communication',
] as const;
---

<BaseLayout {title} {description} canonicalPath="/" image={SITE.founder.image} bodyClass="landing-luxe">
  <header class="luxe-header">
    <a class="luxe-brand" href="#top" aria-label="Sana Patel Real Estate home">
      <img src={SITE.logo} alt="Sana Patel Real Estate" width="190" height="55" decoding="async" />
    </a>
    <div class="luxe-header__contact">
      <a href={`mailto:${SITE.email}`}>Email</a>
      <a class="luxe-header__call" href={`tel:${SITE.phone.e164}`}>Call {SITE.phone.display}</a>
    </div>
  </header>

  <section class="luxe-hero" id="top" aria-labelledby="hero-title">
    <div class="luxe-hero__halo" aria-hidden="true"></div>
    <div class="luxe-hero__grid">
      <div class="luxe-hero__copy">
        <p class="luxe-kicker">Property Management · Melbourne</p>
        <h1 id="hero-title">Property management <span>with PRIDE.</span></h1>
        <p class="luxe-hero__lead">
          One clear point of accountability. Direct communication. Personally led by Sana Patel.
        </p>
        <div class="luxe-hero__actions">
          <a class="luxe-button luxe-button--gold" href={`tel:${SITE.phone.e164}`}>Call Sana</a>
          <a class="luxe-button luxe-button--line" href={`mailto:${SITE.email}`}>Email Sana</a>
        </div>
        <p class="luxe-hero__micro">24×7 direct access to Sana Patel when something needs attention.</p>
      </div>

      <figure class="luxe-hero__portrait">
        <div class="luxe-hero__ring" aria-hidden="true"></div>
        <div class="luxe-hero__arch">
          <img src={SITE.founder.image} alt="Sana Patel" width="900" height="1125" fetchpriority="high" decoding="async" />
        </div>
        <figcaption>Sana Patel · Managing Director / Licensed Estate Agent</figcaption>
      </figure>
    </div>

    <div class="luxe-hero__pride-line" aria-label="PRIDE service values">
      {pride.map((item) => <span><strong>{item.letter}</strong>{item.word}</span>)}
    </div>
  </section>

  <section class="luxe-white" aria-labelledby="promise-title">
    <div class="luxe-shell luxe-statement">
      <div>
        <p class="luxe-kicker luxe-kicker--dark">I · The promise</p>
        <h2 id="promise-title">Your property.<br /><em>My priority.</em></h2>
      </div>
      <div class="luxe-statement__copy">
        <p class="luxe-statement__lead">Property management should feel personal, clear and easy to understand.</p>
        <p>
          You should know who is responsible, understand the next step and be able to speak with the person accountable
          for the service.
        </p>
      </div>
    </div>
  </section>

  <section class="luxe-pride" aria-labelledby="pride-title">
    <div class="luxe-shell">
      <div class="luxe-section-head">
        <div>
          <p class="luxe-kicker">II · The standard</p>
          <h2 id="pride-title">Property management<br />with <em>PRIDE.</em></h2>
        </div>
        <p class="luxe-section-note">Five words. One standard for how the relationship should feel.</p>
      </div>

      <div class="luxe-pride__grid">
        {pride.map((item) => (
          <article class="luxe-pride__card">
            <div class="luxe-pride__letter">{item.letter}</div>
            <div>
              <h3>{item.word}</h3>
              <p>{item.line}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="luxe-service" aria-labelledby="service-title">
    <div class="luxe-shell luxe-service__grid">
      <div class="luxe-service__intro">
        <p class="luxe-kicker luxe-kicker--dark">III · The work</p>
        <h2 id="service-title">The essentials.<br /><em>Clearly handled.</em></h2>
        <p>
          Residential property management for Melbourne rental providers who value direct communication and practical
          oversight.
        </p>
      </div>
      <div class="luxe-service__list">
        {service.map((item, index) => (
          <div class="luxe-service__item">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{item}</strong>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="luxe-founder" aria-labelledby="founder-title">
    <div class="luxe-founder__visual">
      <div class="luxe-founder__disc" aria-hidden="true"></div>
      <div class="luxe-founder__image">
        <img src={SITE.founder.image} alt="Sana Patel" width="900" height="1125" loading="lazy" decoding="async" />
      </div>
    </div>
    <div class="luxe-founder__copy">
      <p class="luxe-kicker">IV · Personally led</p>
      <h2 id="founder-title">Your property should never feel <em>anonymous.</em></h2>
      <p>
        The relationship stays connected to Sana. When something changes, you should understand what happened, why it
        matters and what happens next.
      </p>
      <div class="luxe-founder__contact">
        <a href={`tel:${SITE.phone.e164}`}>{SITE.phone.display}</a>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </div>
    </div>
  </section>

  <section class="luxe-reviews" id="reviews" aria-labelledby="reviews-title">
    <div class="luxe-shell">
      <div class="luxe-section-head luxe-section-head--review">
        <div>
          <p class="luxe-kicker luxe-kicker--dark">V · Current client reviews</p>
          <h2 id="reviews-title">Trust is better read <em>at the source.</em></h2>
        </div>
        <a class="luxe-review-link" href={SITE.reviews.trustindexSummaryUrl} target="_blank" rel="noopener noreferrer">
          Trustindex ↗
        </a>
      </div>

      <div
        class="luxe-trustindex"
        data-review-provider="Trustindex"
        data-trustindex-widget-id={SITE.reviews.trustindexWidgetId}
        data-trustindex-state="waiting"
        aria-busy="true"
      >
        <div class="luxe-trustindex__loading" aria-hidden="true">
          <span>Live reviews</span>
          <strong>Connecting to Trustindex…</strong>
        </div>
        <noscript>
          <p>
            Live reviews require JavaScript. <a href={SITE.reviews.trustindexSummaryUrl}>Read Sana's current reviews on Trustindex.</a>
          </p>
        </noscript>
      </div>
    </div>
  </section>

  <section class="luxe-close" aria-labelledby="close-title">
    <div class="luxe-close__ring" aria-hidden="true"></div>
    <div class="luxe-shell luxe-close__inner">
      <p class="luxe-kicker">The close</p>
      <h2 id="close-title">No forms.<br />No maze.<br /><em>Talk to Sana.</em></h2>
      <p>If you want to discuss your property, start with a call or email.</p>
      <div class="luxe-close__actions">
        <a class="luxe-close__phone" href={`tel:${SITE.phone.e164}`}>{SITE.phone.display}</a>
        <a class="luxe-close__mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </div>
    </div>
  </section>

  <footer class="luxe-footer">
    <span>© {new Date().getFullYear()} {SITE.name}</span>
    <span>Melbourne, Victoria</span>
    <a href={SITE.reviews.trustindexSummaryUrl} target="_blank" rel="noopener noreferrer">Trustindex</a>
  </footer>

  <script>
    const hosts = document.querySelectorAll<HTMLElement>('[data-trustindex-widget-id]');

    const loadTrustindex = (host: HTMLElement) => {
      if (host.dataset.trustindexState !== 'waiting') return;
      const widgetId = host.dataset.trustindexWidgetId;
      if (!widgetId || !/^[a-f0-9]{24,64}$/.test(widgetId)) {
        host.dataset.trustindexState = 'unavailable';
        host.setAttribute('aria-busy', 'false');
        return;
      }

      host.dataset.trustindexState = 'loading';
      const loading = host.querySelector<HTMLElement>('.luxe-trustindex__loading');
      const markReady = (event: Event) => {
        const detail = (event as CustomEvent<{ widget?: { widget?: Element } }>).detail;
        const widget = detail?.widget?.widget;
        if (!widget || !host.contains(widget)) return;
        loading?.remove();
        host.dataset.trustindexState = 'ready';
        host.setAttribute('aria-busy', 'false');
        window.removeEventListener('widget-ready', markReady);
      };

      window.addEventListener('widget-ready', markReady);
      const script = document.createElement('script');
      script.async = true;
      script.defer = true;
      script.src = `https://cdn.trustindex.io/loader.js?${widgetId}`;
      script.referrerPolicy = 'origin';
      script.setAttribute('fetchpriority', 'low');
      script.addEventListener('error', () => {
        host.dataset.trustindexState = 'unavailable';
        host.setAttribute('aria-busy', 'false');
        loading?.querySelector('strong')?.replaceChildren('Reviews are temporarily unavailable.');
        window.removeEventListener('widget-ready', markReady);
      });
      host.append(script);
    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const host = entry.target as HTMLElement;
            observer.unobserve(host);
            loadTrustindex(host);
          }
        },
        { rootMargin: '180px 0px' },
      );
      hosts.forEach((host) => observer.observe(host));
    } else {
      hosts.forEach(loadTrustindex);
    }
  </script>
</BaseLayout>

<style>
  :global(body.landing-luxe) {
    --lx-black: #080906;
    --lx-black-soft: #11120e;
    --lx-white: #fffefa;
    --lx-ivory: #f4f0e6;
    --lx-gold: #b39258;
    --lx-gold-bright: #d8bc82;
    --lx-gold-deep: #80643a;
    --lx-line: rgba(184, 154, 96, 0.3);
    margin: 0;
    background: var(--lx-black);
    color: var(--lx-white);
    overflow-x: clip;
  }

  :global(body.landing-luxe main) { overflow: clip; }
  .luxe-shell { width: min(100% - 2rem, 84rem); margin-inline: auto; }

  .luxe-header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 20;
    width: min(100% - 2.2rem, 90rem);
    margin-inline: auto;
    min-height: 6.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    border-bottom: 1px solid rgba(255,255,255,.12);
  }
  .luxe-brand { min-height: 3.5rem; display: inline-flex; align-items: center; }
  .luxe-brand img { width: clamp(9.8rem, 14vw, 12.5rem); height: auto; }
  .luxe-header__contact { display: flex; align-items: center; gap: .65rem; }
  .luxe-header__contact a {
    min-height: 2.8rem; padding: .8rem 1rem; display: inline-flex; align-items: center; justify-content: center;
    border: 1px solid transparent; color: var(--lx-white); font-size: .75rem; font-weight: 700;
    letter-spacing: .07em; text-transform: uppercase;
  }
  .luxe-header__call { border-color: var(--lx-line) !important; border-radius: 999px; background: rgba(255,255,255,.035); }

  .luxe-kicker { margin: 0; color: var(--lx-gold-bright); font-size: .7rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; }
  .luxe-kicker--dark { color: var(--lx-gold-deep); }

  .luxe-hero {
    position: relative; min-height: 100svh; padding: 7.8rem max(1rem, calc((100vw - 90rem)/2)) 0;
    display: grid; align-content: end;
    background:
      radial-gradient(circle at 72% 34%, rgba(216,188,130,.16), transparent 28rem),
      radial-gradient(circle at 8% 88%, rgba(184,154,96,.08), transparent 26rem),
      linear-gradient(135deg,#070806 0%,#11120e 58%,#080906 100%);
  }
  .luxe-hero::before {
    content: ''; position: absolute; inset: 0; pointer-events: none; opacity: .16;
    background-image: linear-gradient(rgba(255,255,255,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.03) 1px,transparent 1px);
    background-size: 5rem 5rem; mask-image: linear-gradient(to bottom,transparent 0%,#000 22%,#000 78%,transparent 100%);
  }
  .luxe-hero__halo {
    position: absolute; width: min(46vw,42rem); aspect-ratio: 1; right: -7vw; top: 16vh; border-radius: 50%;
    border: 1px solid rgba(216,188,130,.2); box-shadow: 0 0 0 4rem rgba(184,154,96,.025),0 0 0 9rem rgba(184,154,96,.018);
  }
  .luxe-hero__grid {
    position: relative; z-index: 2; width: min(100%,90rem); margin-inline: auto; display: grid;
    grid-template-columns: minmax(0,1.05fr) minmax(24rem,.78fr); gap: clamp(2rem,5vw,7rem); align-items: center;
    min-height: calc(100svh - 12rem); padding-block: clamp(2rem,5vw,5rem);
  }
  .luxe-hero h1 {
    margin: 1.35rem 0 0; max-width: 10ch; font-family: var(--font-sans); font-size: clamp(4rem,8vw,8.2rem);
    font-weight: 520; letter-spacing: -.065em; line-height: .86;
  }
  .luxe-hero h1 span { display: block; margin-top: .2em; color: var(--lx-gold-bright); font-family: var(--font-display); font-weight: 370; letter-spacing: -.04em; }
  .luxe-hero__lead { max-width: 35rem; margin-top: 2rem; color: rgba(255,254,250,.72); font-size: clamp(1.05rem,1.3vw,1.24rem); line-height: 1.62; }
  .luxe-hero__actions { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 2.1rem; }
  .luxe-button {
    min-height: 3.35rem; min-width: 10rem; padding: .95rem 1.4rem; display: inline-flex; align-items: center; justify-content: center;
    border: 1px solid var(--lx-gold); border-radius: 999px; font-size: .76rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
    transition: transform 180ms ease, background 180ms ease, color 180ms ease;
  }
  .luxe-button:hover { transform: translateY(-2px); }
  .luxe-button--gold { background: var(--lx-gold-bright); border-color: var(--lx-gold-bright); color: var(--lx-black); }
  .luxe-button--line { color: var(--lx-white); background: transparent; }
  .luxe-hero__micro { margin-top: 1.15rem; color: rgba(255,254,250,.48); font-size: .78rem; }

  .luxe-hero__portrait { position: relative; width: min(100%,33rem); justify-self: end; min-height: 38rem; margin: 0; display: grid; place-items: end center; }
  .luxe-hero__ring {
    position: absolute; width: 88%; aspect-ratio: .88; right: -6%; top: 3%; border: 1px solid rgba(216,188,130,.58);
    border-radius: 50% 50% 8% 8%; transform: rotate(7deg);
  }
  .luxe-hero__arch {
    position: relative; z-index: 2; width: 84%; aspect-ratio: .76; overflow: hidden; border: 1px solid rgba(216,188,130,.52);
    border-radius: 48% 48% 4rem 4rem; background: var(--lx-white); box-shadow: 0 2.5rem 7rem rgba(0,0,0,.4);
  }
  .luxe-hero__arch img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 10%; }
  .luxe-hero__portrait figcaption {
    position: absolute; z-index: 4; right: 0; bottom: 1.2rem; padding: .75rem 1rem; background: rgba(8,9,6,.86);
    border: 1px solid var(--lx-line); color: rgba(255,254,250,.7); font-size: .68rem; letter-spacing: .07em; text-transform: uppercase;
  }
  .luxe-hero__pride-line {
    position: relative; z-index: 3; width: min(100%,90rem); margin-inline: auto; min-height: 5.6rem; display: grid;
    grid-template-columns: repeat(5,1fr); border-top: 1px solid rgba(255,255,255,.12);
  }
  .luxe-hero__pride-line span {
    display: flex; align-items: center; justify-content: center; gap: .55rem; color: rgba(255,254,250,.62);
    font-size: .7rem; letter-spacing: .07em; text-transform: uppercase;
  }
  .luxe-hero__pride-line span + span { border-left: 1px solid rgba(255,255,255,.08); }
  .luxe-hero__pride-line strong { color: var(--lx-gold-bright); font-family: var(--font-display); font-size: 1.8rem; font-weight: 400; }

  .luxe-white { padding: clamp(6rem,11vw,10rem) 0; background: var(--lx-white); color: var(--lx-black); }
  .luxe-statement { display: grid; grid-template-columns: minmax(0,1.35fr) minmax(18rem,.65fr); gap: clamp(3rem,8vw,8rem); align-items: end; }
  .luxe-statement h2, .luxe-service h2 {
    margin: 1.2rem 0 0; max-width: 14ch; font-family: var(--font-display); font-size: clamp(3.2rem,6vw,6.8rem);
    font-weight: 360; letter-spacing: -.05em; line-height: .94;
  }
  .luxe-statement h2 em, .luxe-service h2 em { color: var(--lx-gold-deep); font-weight: 350; }
  .luxe-statement__copy { padding-bottom: .4rem; }
  .luxe-statement__copy p { margin: 1rem 0 0; max-width: 31rem; color: rgba(9,10,8,.62); line-height: 1.72; }
  .luxe-statement__copy .luxe-statement__lead { color: var(--lx-black); font-family: var(--font-display); font-size: clamp(1.5rem,2.4vw,2.2rem); line-height: 1.2; }

  .luxe-pride { padding: clamp(6rem,10vw,9rem) 0; background: linear-gradient(180deg,rgba(184,154,96,.04),transparent 20%),var(--lx-black-soft); }
  .luxe-section-head { display: flex; align-items: end; justify-content: space-between; gap: 2rem; }
  .luxe-section-head h2 {
    margin: 1rem 0 0; max-width: 16ch; font-family: var(--font-display); font-size: clamp(3.2rem,5vw,5.8rem);
    font-weight: 360; letter-spacing: -.05em; line-height: .95;
  }
  .luxe-section-head h2 em { color: var(--lx-gold-bright); font-weight: 350; }
  .luxe-section-note { max-width: 22rem; margin: 0; color: rgba(255,254,250,.5); font-size: .9rem; line-height: 1.6; }
  .luxe-pride__grid { margin-top: clamp(3.5rem,6vw,6rem); display: grid; grid-template-columns: repeat(5,1fr); border-top: 1px solid var(--lx-line); border-bottom: 1px solid var(--lx-line); }
  .luxe-pride__card {
    min-height: 24rem; padding: 1.7rem 1.35rem 2rem; display: flex; flex-direction: column; justify-content: space-between; gap: 3rem;
    background: linear-gradient(180deg,rgba(255,255,255,.025),transparent);
  }
  .luxe-pride__card + .luxe-pride__card { border-left: 1px solid var(--lx-line); }
  .luxe-pride__letter { color: var(--lx-gold-bright); font-family: var(--font-display); font-size: clamp(5rem,8vw,8rem); font-weight: 350; line-height: .82; }
  .luxe-pride__card h3 { margin: 0; font-size: 1.05rem; font-weight: 650; }
  .luxe-pride__card p { margin: .7rem 0 0; color: rgba(255,254,250,.56); font-size: .88rem; line-height: 1.6; }

  .luxe-service { padding: clamp(6rem,10vw,9rem) 0; background: var(--lx-ivory); color: var(--lx-black); }
  .luxe-service__grid { display: grid; grid-template-columns: minmax(0,.8fr) minmax(24rem,1.2fr); gap: clamp(3rem,8vw,8rem); align-items: start; }
  .luxe-service__intro > p:last-child { max-width: 31rem; margin-top: 1.5rem; color: rgba(9,10,8,.62); line-height: 1.7; }
  .luxe-service__list { border-top: 1px solid rgba(9,10,8,.2); }
  .luxe-service__item { min-height: 5.1rem; display: grid; grid-template-columns: 4rem 1fr; align-items: center; gap: 1rem; border-bottom: 1px solid rgba(9,10,8,.17); }
  .luxe-service__item span { color: var(--lx-gold-deep); font-size: .7rem; letter-spacing: .12em; }
  .luxe-service__item strong { font-family: var(--font-display); font-size: clamp(1.45rem,2.2vw,2.15rem); font-weight: 390; }

  .luxe-founder { min-height: 46rem; display: grid; grid-template-columns: 1fr 1fr; background: var(--lx-black); }
  .luxe-founder__visual {
    position: relative; min-height: 46rem; display: grid; place-items: end center; overflow: hidden;
    background: radial-gradient(circle at 46% 44%,rgba(216,188,130,.15),transparent 25rem),#0e0f0c;
  }
  .luxe-founder__disc { position: absolute; width: min(32rem,70%); aspect-ratio: 1; border-radius: 50%; background: var(--lx-gold); opacity: .88; top: 14%; left: 50%; transform: translateX(-50%); }
  .luxe-founder__image {
    position: relative; z-index: 2; width: min(31rem,70%); height: 84%; overflow: hidden; border-radius: 50% 50% 0 0;
    background: var(--lx-white); box-shadow: 0 2rem 5rem rgba(0,0,0,.4);
  }
  .luxe-founder__image img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 12%; }
  .luxe-founder__copy { padding: clamp(4rem,8vw,8rem); align-self: center; }
  .luxe-founder__copy h2 {
    margin: 1.1rem 0 0; max-width: 11ch; font-family: var(--font-display); font-size: clamp(3.3rem,5.5vw,6rem);
    font-weight: 360; letter-spacing: -.05em; line-height: .95;
  }
  .luxe-founder__copy h2 em { color: var(--lx-gold-bright); font-weight: 350; }
  .luxe-founder__copy > p:not(.luxe-kicker) { max-width: 34rem; margin-top: 1.7rem; color: rgba(255,254,250,.62); font-size: 1.05rem; line-height: 1.72; }
  .luxe-founder__contact { margin-top: 2.3rem; display: grid; width: fit-content; border-top: 1px solid var(--lx-line); }
  .luxe-founder__contact a { min-height: 3.6rem; display: flex; align-items: center; padding-right: 2.5rem; border-bottom: 1px solid var(--lx-line); color: var(--lx-white); font-size: 1rem; }
  .luxe-founder__contact a:first-child { color: var(--lx-gold-bright); font-family: var(--font-display); font-size: 1.6rem; }

  .luxe-reviews { padding: clamp(6rem,10vw,9rem) 0; background: var(--lx-white); color: var(--lx-black); }
  .luxe-section-head--review h2 { color: var(--lx-black); }
  .luxe-section-head--review h2 em { color: var(--lx-gold-deep); }
  .luxe-review-link {
    min-height: 3rem; padding: .85rem 1rem; display: inline-flex; align-items: center; border: 1px solid rgba(9,10,8,.2);
    border-radius: 999px; color: var(--lx-black); font-size: .75rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase;
