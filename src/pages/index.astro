---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import CredentialStrip from '@/components/CredentialStrip.astro';
import TrustProof from '@/components/TrustProof.astro';
import { SITE } from '@/config/site';

const title = 'Property Management Melbourne | Sana Patel Real Estate';
const description =
  'Clear, founder-led Melbourne property management with direct access to Sana Patel, practical oversight and a straightforward next step for rental providers.';

const businessId = new URL('/#business', SITE.url).toString();
const founderId = new URL('/about/#sana-patel', SITE.url).toString();
const websiteId = new URL('/#website', SITE.url).toString();

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': websiteId,
    name: SITE.name,
    url: SITE.url,
    publisher: {
      '@id': businessId,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'RealEstateAgent',
    '@id': businessId,
    name: SITE.name,
    url: SITE.url,
    telephone: SITE.phone.schema,
    email: SITE.email,
    areaServed: SITE.areaServed,
    logo: {
      '@type': 'ImageObject',
      url: SITE.logo,
    },
    image: SITE.defaultOgImage,
    sameAs: [...SITE.profiles.business],
    founder: {
      '@type': 'Person',
      '@id': founderId,
      name: SITE.founder.name,
      jobTitle: 'Managing Director / Licensed Estate Agent',
      url: SITE.founder.profileUrl,
      image: SITE.founder.image,
      sameAs: [...SITE.profiles.founder],
    },
  },
];

const credentials = [
  { label: 'Service', value: 'Residential property management' },
  { label: 'Founder-led', value: 'Sana Patel' },
  { label: 'Professional standing', value: 'Licensed Estate Agent' },
  { label: 'Direct access', value: '24×7 to Sana Patel' },
];

const ownerJourneys = [
  {
    number: '01',
    title: 'Manage my property',
    body: 'Leasing, inspections, maintenance, rent collection, arrears, renewals and day-to-day oversight in one accountable service.',
    href: '/rental-providers/',
    link: 'See property management',
  },
  {
    number: '02',
    title: 'Appraise or lease my property',
    body: 'Start with the property, current market context and a clear conversation about the rental position and next move.',
    href: '/rental-appraisal/',
    link: 'Request a rental appraisal',
  },
  {
    number: '03',
    title: 'Change property manager',
    body: 'If you are chasing updates or unsure who is accountable, start by understanding the current arrangement and handover options.',
    href: '/switch-property-managers/',
    link: 'Understand switching',
  },
];
---

<BaseLayout {title} {description} canonicalPath="/" {schema}>
  <SiteHeader slot="header" />

  <section class="hero hero-refresh" aria-labelledby="hero-title">
    <div class="container-wide hero-refresh__inner">
      <div class="hero__content hero-refresh__copy">
        <p class="eyebrow">Property Management · Melbourne</p>
        <h1 id="hero-title" class="hero__title">Clear property management. Directly with Sana.</h1>
        <p class="hero__lead">
          For rental providers who want one accountable point of contact, clear advice and a property manager they can
          actually call.
        </p>
        <div class="hero__actions">
          <a class="button button--solid hero-refresh__call" href={`tel:${SITE.phone.e164}`}>Call Sana · {SITE.phone.display}</a>
          <a class="button button--light" href="/rental-appraisal/">Request a rental appraisal</a>
        </div>
        <p class="hero-refresh__credential">Managing Director / Licensed Estate Agent · Melbourne</p>
      </div>

      <figure class="hero-refresh__visual" aria-label="Founder photography concept placeholder">
        <div class="hero-refresh__halo" aria-hidden="true"></div>
        <img
          class="hero-refresh__portrait"
          src="/media/founder-concept-placeholder.svg"
          alt=""
          width="1200"
          height="1500"
          fetchpriority="high"
        />
        <figcaption>Concept composition · replace with approved Sana photography before production</figcaption>
      </figure>
    </div>
  </section>

  <CredentialStrip items={credentials} />

  <section class="section owner-start" id="services" aria-labelledby="services-title">
    <div class="container-wide owner-start__intro">
      <p class="eyebrow">Start with what you need</p>
      <h2 id="services-title">Property management should be easy to understand.</h2>
      <p>Choose the situation that sounds like yours. You can read more, request an appraisal or simply call Sana.</p>
    </div>

    <div class="container-wide owner-start__grid">
      {
        ownerJourneys.map((journey) => (
          <article class="owner-start__card">
            <span class="owner-start__number">{journey.number}</span>
            <div>
              <h3>{journey.title}</h3>
              <p>{journey.body}</p>
            </div>
            <a href={journey.href}>{journey.link} <span aria-hidden="true">→</span></a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="clarity-band" aria-labelledby="clarity-title">
    <div class="container-wide clarity-band__inner">
      <div>
        <p class="eyebrow">The standard</p>
        <h2 id="clarity-title">Know who is responsible. Know what happens next.</h2>
      </div>
      <div class="clarity-band__copy">
        <p>
          Property management becomes frustrating when owners have to chase information or work out who owns the next
          step. Sana's service model is built around direct accountability and useful communication.
        </p>
        <div class="clarity-band__points" aria-label="Service principles">
          <span>One clear point of accountability</span>
          <span>Context around important decisions</span>
          <span>Visible follow-through when something changes</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section founder-section" id="why-sana" aria-labelledby="founder-title">
    <div class="container-wide founder-section__grid">
      <figure class="founder-section__portrait" aria-label="Founder photography concept placeholder">
        <div class="founder-section__shape" aria-hidden="true"></div>
        <img src="/media/founder-concept-placeholder.svg" alt="" width="1200" height="1500" loading="lazy" />
      </figure>

      <div class="founder-section__copy">
        <p class="eyebrow">Why Sana</p>
        <h2 id="founder-title">A direct relationship, not another layer of management.</h2>
        <p class="founder-section__lead">
          Sana Patel Real Estate is founder-led. When something needs attention, the relationship stays connected to the
          person accountable for the service.
        </p>
        <div class="founder-section__principles">
          <article>
            <h3>Direct access</h3>
            <p>Sana's service model includes 24×7 direct access when something needs attention.</p>
          </article>
          <article>
            <h3>Clear next steps</h3>
            <p>Communication should help you understand what happened, why it matters and what happens next.</p>
          </article>
          <article>
            <h3>Practical oversight</h3>
            <p>Leasing, inspections, maintenance, tenancy and rental decisions are considered as connected parts of the investment.</p>
          </article>
        </div>
        <div class="founder-section__actions">
          <a class="button button--solid" href={`tel:${SITE.phone.e164}`}>Call Sana</a>
          <a class="text-link" href="/about/">Read Sana's background <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section simple-process" aria-labelledby="process-title">
    <div class="container-wide simple-process__header">
      <p class="eyebrow">What happens next</p>
      <h2 id="process-title">A simple first conversation.</h2>
    </div>
    <div class="container-wide simple-process__grid">
      <article>
        <span>01</span>
        <h3>Tell Sana what is happening</h3>
        <p>Share the property, current situation and what you want to improve.</p>
      </article>
      <article>
        <span>02</span>
        <h3>Understand the next step</h3>
        <p>Sana can explain what information is needed and what the practical options look like.</p>
      </article>
      <article>
        <span>03</span>
        <h3>Decide if the fit is right</h3>
        <p>You can move forward only after the service and next step are clear.</p>
      </article>
    </div>
  </section>

  <div id="reviews">
    <TrustProof />
  </div>

  <section class="section direct-contact" aria-labelledby="contact-title">
    <div class="container-wide direct-contact__inner">
      <div>
        <p class="eyebrow">Prefer to talk?</p>
        <h2 id="contact-title">Call Sana directly.</h2>
        <p>No maze of pages. No need to work out the right form first. Start with the conversation.</p>
      </div>
      <div class="direct-contact__action">
        <a class="direct-contact__phone" href={`tel:${SITE.phone.e164}`}>{SITE.phone.display}</a>
        <a class="button button--light" href="/rental-appraisal/">Or request an appraisal</a>
      </div>
    </div>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .hero-refresh {
    min-height: 48rem;
    display: grid;
    align-items: center;
    padding-top: 6.3rem;
    background:
      radial-gradient(circle at 74% 32%, rgba(184, 154, 96, 0.16), transparent 29rem),
      linear-gradient(135deg, #0d0e0c 0%, #141510 58%, #0b0c0a 100%);
  }
  .hero-refresh::after {
    background:
      linear-gradient(90deg, rgba(8, 9, 7, 0.08), rgba(8, 9, 7, 0.02) 54%, rgba(8, 9, 7, 0.22)),
      linear-gradient(180deg, transparent 65%, rgba(8, 9, 7, 0.34));
  }
  .hero-refresh__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(22rem, 0.86fr);
    gap: clamp(2rem, 5vw, 6rem);
    align-items: center;
    min-height: calc(48rem - 6.3rem);
    padding-block: clamp(3rem, 6vw, 5rem);
  }
  .hero-refresh__copy {
    width: auto;
    margin: 0;
    padding: 0;
  }
  .hero-refresh .eyebrow {
    color: var(--gold-soft);
  }
  .hero-refresh .hero__title {
    max-width: 10.5ch;
    margin-top: 1.1rem;
    font-family: var(--font-sans);
    font-size: clamp(3.4rem, 6.6vw, 6.9rem);
    font-weight: 680;
    letter-spacing: -0.058em;
    line-height: 0.92;
  }
  .hero-refresh .hero__lead {
    max-width: 36rem;
    font-size: clamp(1.06rem, 1rem + 0.3vw, 1.24rem);
    line-height: 1.55;
  }
  .hero-refresh__call {
    background: var(--gold-soft);
    border-color: var(--gold-soft);
    color: #11120f;
  }
  .hero-refresh__call:hover {
    background: var(--white);
    border-color: var(--white);
    color: #11120f;
  }
  .hero-refresh__credential {
    margin-top: 1.25rem;
    color: rgba(255, 253, 248, 0.58);
    font-size: 0.78rem;
    letter-spacing: 0.025em;
  }
  .hero-refresh__visual {
    position: relative;
    min-height: 35rem;
    margin: 0;
    display: grid;
    place-items: end center;
  }
  .hero-refresh__halo {
    position: absolute;
    width: min(90%, 34rem);
    aspect-ratio: 1;
    top: 9%;
    right: 2%;
    border: 1px solid rgba(215, 195, 154, 0.55);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(215, 195, 154, 0.18), rgba(184, 154, 96, 0.03) 62%, transparent 63%);
  }
  .hero-refresh__portrait {
    position: relative;
    width: min(100%, 33rem);
    max-height: 38rem;
    object-fit: cover;
    border-radius: 48% 48% 0.8rem 0.8rem / 30% 30% 0.8rem 0.8rem;
    filter: saturate(0.92) contrast(1.02);
    box-shadow: 0 2.4rem 5.5rem rgba(0, 0, 0, 0.34);
  }
  .hero-refresh__visual figcaption {
    position: absolute;
    right: 0;
    bottom: 0.65rem;
    max-width: 14rem;
    padding: 0.55rem 0.7rem;
    background: rgba(13, 14, 12, 0.84);
    color: rgba(255, 253, 248, 0.64);
    font-size: 0.63rem;
    line-height: 1.35;
    text-align: right;
  }

  .owner-start {
    background: var(--white);
  }
  .owner-start__intro {
    display: grid;
    grid-template-columns: 0.72fr 1.05fr 0.72fr;
    gap: var(--space-4);
    align-items: end;
  }
  .owner-start__intro h2 {
    max-width: 12ch;
    font-size: var(--h2);
  }
  .owner-start__intro > p:last-child {
    max-width: 30rem;
    color: var(--ink-soft);
  }
  .owner-start__grid {
    margin-top: var(--space-5);
    border-top: 1px solid var(--line-strong);
  }
  .owner-start__card {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) minmax(11rem, 0.36fr);
    gap: var(--space-3);
    align-items: center;
    padding: clamp(1.6rem, 3vw, 2.5rem) 0;
    border-bottom: 1px solid var(--line);
  }
  .owner-start__number {
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-style: italic;
  }
  .owner-start__card h3 {
    font-family: var(--font-sans);
    font-size: clamp(1.55rem, 2.8vw, 2.65rem);
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .owner-start__card p {
    max-width: 43rem;
    margin-top: 0.65rem;
    color: var(--ink-soft);
  }
  .owner-start__card > a {
    justify-self: end;
    color: var(--accent-deep);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .clarity-band {
    padding-block: var(--space-6);
    background:
      radial-gradient(circle at 88% 8%, rgba(184, 154, 96, 0.13), transparent 28rem),
      #11120f;
    color: var(--white);
  }
  .clarity-band__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
    gap: var(--space-5);
    align-items: start;
  }
  .clarity-band .eyebrow {
    color: var(--gold-soft);
  }
  .clarity-band h2 {
    max-width: 12ch;
    margin-top: var(--space-2);
    font-size: var(--h2);
  }
  .clarity-band__copy > p {
    max-width: 40rem;
    color: rgba(255, 253, 248, 0.76);
    font-size: var(--body-lg);
  }
  .clarity-band__points {
    display: grid;
    margin-top: var(--space-4);
    border-top: 1px solid rgba(215, 195, 154, 0.25);
  }
  .clarity-band__points span {
    padding: 1.05rem 0;
    border-bottom: 1px solid rgba(215, 195, 154, 0.18);
    color: rgba(255, 253, 248, 0.86);
  }

  .founder-section {
    background:
      radial-gradient(circle at 8% 20%, rgba(184, 154, 96, 0.12), transparent 24rem),
      var(--paper);
  }
  .founder-section__grid {
    display: grid;
    grid-template-columns: minmax(20rem, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }
  .founder-section__portrait {
    position: relative;
    min-height: 42rem;
    margin: 0;
    display: grid;
    place-items: end center;
  }
  .founder-section__shape {
    position: absolute;
    inset: 2rem 0 1rem 5%;
    border-radius: 48% 48% 1rem 1rem / 25% 25% 1rem 1rem;
    background: var(--gold-soft);
    opacity: 0.38;
    transform: rotate(-3deg);
  }
  .founder-section__portrait img {
    position: relative;
    width: min(92%, 31rem);
    max-height: 40rem;
    object-fit: cover;
    border-radius: 48% 48% 0.8rem 0.8rem / 28% 28% 0.8rem 0.8rem;
    box-shadow: var(--shadow-lift);
  }
  .founder-section__copy h2 {
    max-width: 12ch;
    margin-top: var(--space-2);
    font-size: var(--h2);
  }
  .founder-section__lead {
    max-width: 42rem;
    margin-top: var(--space-3);
    color: var(--ink-soft);
    font-size: var(--body-lg);
  }
  .founder-section__principles {
    margin-top: var(--space-4);
    border-top: 1px solid var(--line-strong);
  }
  .founder-section__principles article {
    display: grid;
    grid-template-columns: minmax(8rem, 0.4fr) minmax(0, 1fr);
    gap: var(--space-3);
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--line);
  }
  .founder-section__principles h3 {
    font-family: var(--font-sans);
    font-size: 1.02rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .founder-section__principles p {
    max-width: 35rem;
    color: var(--ink-soft);
  }
  .founder-section__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-top: var(--space-4);
  }
  .text-link {
    color: var(--accent-deep);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .simple-process {
    background: var(--white);
  }
  .simple-process__header {
    display: grid;
    grid-template-columns: 0.6fr 1.4fr;
    gap: var(--space-4);
    align-items: end;
  }
  .simple-process__header h2 {
    max-width: 12ch;
    font-size: var(--h2);
  }
  .simple-process__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: var(--space-5);
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }
  .simple-process__grid article {
    min-height: 16rem;
    padding: var(--space-3);
    border-right: 1px solid var(--line);
  }
  .simple-process__grid article:last-child {
    border-right: 0;
  }
  .simple-process__grid span {
    color: var(--accent);
    font-family: var(--font-display);
    font-style: italic;
  }
  .simple-process__grid h3 {
    max-width: 13ch;
    margin-top: var(--space-4);
    font-family: var(--font-sans);
    font-size: clamp(1.45rem, 2.2vw, 2rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .simple-process__grid p {
    max-width: 28rem;
    margin-top: var(--space-2);
    color: var(--ink-soft);
  }

  .direct-contact {
    position: relative;
    overflow: clip;
    background:
      radial-gradient(circle at 88% 0%, rgba(184, 154, 96, 0.18), transparent 25rem),
      #0f100d;
    color: var(--white);
  }
  .direct-contact::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
  }
  .direct-contact__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.7fr);
    gap: var(--space-5);
    align-items: end;
  }
  .direct-contact .eyebrow {
    color: var(--gold-soft);
  }
  .direct-contact h2 {
    margin-top: var(--space-2);
    font-family: var(--font-sans);
    font-size: clamp(3rem, 5.5vw, 5.8rem);
    font-weight: 680;
    letter-spacing: -0.055em;
    line-height: 0.94;
  }
  .direct-contact p {
    max-width: 38rem;
    margin-top: var(--space-3);
    color: rgba(255, 253, 248, 0.7);
    font-size: var(--body-lg);
  }
  .direct-contact__action {
    display: grid;
    justify-items: start;
    gap: 1.2rem;
  }
  .direct-contact__phone {
    color: var(--gold-soft);
    font-family: var(--font-sans);
    font-size: clamp(2rem, 4vw, 3.6rem);
    font-weight: 650;
    letter-spacing: -0.04em;
    line-height: 1;
    text-decoration-thickness: 1px;
  }

  @media (max-width: 980px) {
    .hero-refresh__inner,
    .founder-section__grid {
      grid-template-columns: 1fr 0.78fr;
      gap: 2rem;
    }
    .hero-refresh .hero__title {
      font-size: clamp(3.3rem, 8vw, 5.4rem);
    }
    .owner-start__intro {
      grid-template-columns: 1fr 1.2fr;
    }
    .owner-start__intro > p:last-child {
      grid-column: 2;
    }
    .owner-start__card {
      grid-template-columns: 3rem minmax(0, 1fr);
    }
    .owner-start__card > a {
      grid-column: 2;
      justify-self: start;
    }
  }

  @media (max-width: 760px) {
    .hero-refresh {
      min-height: auto;
      padding-top: 5.5rem;
    }
    .hero-refresh__inner,
    .founder-section__grid,
    .clarity-band__inner,
    .direct-contact__inner {
      grid-template-columns: 1fr;
    }
    .hero-refresh__inner {
      padding-top: 3.2rem;
      padding-bottom: 0;
    }
    .hero-refresh__copy {
      padding-bottom: 1.5rem;
    }
    .hero-refresh .hero__title {
      max-width: 9.5ch;
      font-size: clamp(3.2rem, 15vw, 5.2rem);
    }
    .hero-refresh .hero__actions {
      display: grid;
      grid-template-columns: 1fr;
    }
    .hero-refresh .button {
      width: 100%;
    }
    .hero-refresh__visual {
      min-height: 30rem;
    }
    .hero-refresh__portrait {
      width: min(94%, 29rem);
      max-height: 32rem;
    }
    .hero-refresh__visual figcaption {
      right: 0.5rem;
    }
    .owner-start__intro,
    .simple-process__header {
      grid-template-columns: 1fr;
    }
    .owner-start__intro > p:last-child {
      grid-column: auto;
    }
    .founder-section__portrait {
      min-height: 34rem;
      order: 2;
    }
    .founder-section__copy {
      order: 1;
    }
    .simple-process__grid {
      grid-template-columns: 1fr;
    }
    .simple-process__grid article {
      min-height: auto;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
    .simple-process__grid article:last-child {
      border-bottom: 0;
    }
  }

  @media (max-width: 560px) {
    .hero-refresh__visual {
      min-height: 25rem;
    }
    .hero-refresh__portrait {
      max-height: 27rem;
    }
    .hero-refresh__visual figcaption {
      max-width: 12rem;
      font-size: 0.58rem;
    }
    .owner-start__card {
      grid-template-columns: 2.4rem minmax(0, 1fr);
      gap: 0.8rem;
    }
    .founder-section__portrait {
      min-height: 28rem;
    }
    .founder-section__principles article {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }
  }
</style>
