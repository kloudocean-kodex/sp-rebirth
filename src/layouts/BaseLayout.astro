---
import '@/styles/global.css';
import '@/styles/brand.css';
import { SITE } from '@/config/site';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  image?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  bodyClass?: string;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  image = SITE.defaultOgImage,
  noindex = false,
  schema,
  bodyClass = '',
} = Astro.props;

const site = Astro.site ?? new URL(SITE.url);
const canonical = new URL(canonicalPath, site);
const ogImage = new URL(image, site);
const isProduction = import.meta.env.PUBLIC_DEPLOY_ENV === 'production';
const effectiveNoindex = noindex || !isProduction;
const businessId = new URL('/#business', site).toString();
const founderId = new URL('/about/#sana-patel', site).toString();
const defaultSchema = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  '@id': businessId,
  name: SITE.name,
  url: site.toString(),
  telephone: SITE.phone.schema,
  email: SITE.email,
  areaServed: SITE.areaServed,
  logo: {
    '@type': 'ImageObject',
    url: SITE.logo,
  },
  image: SITE.defaultOgImage,
  sameAs: [...SITE.profiles.business],
  founder: {
    '@type': 'Person',
    '@id': founderId,
    name: SITE.founder.name,
    url: SITE.founder.profileUrl,
    sameAs: [...SITE.profiles.founder],
  },
};
const schemaPayload = schema ?? defaultSchema;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#171713" />
    <link rel="icon" type="image/jpeg" href={SITE.favicon} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {effectiveNoindex && <meta name="robots" content="noindex,nofollow" />}

    <!--
      SP_REBIRTH uses a tightly scoped two-family type system. We preconnect rather
      than preloading arbitrary font files so the browser can request only the
      faces required by the current page. Production self-hosting remains a
      performance option once final font/asset measurements are available.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400..700&family=Newsreader:opsz,wght@6..72,300..600&display=swap"
    />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaPayload)} />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot name="header" />
    <main id="main-content">
      <slot />
    </main>
    <slot name="footer" />

    <script is:inline>
      (() => {
        const storageKey = 'sp:lead-attribution:v1';
        const maxValue = 180;
        const maxUrl = 700;
        const clean = (value) =>
          typeof value === 'string' ? value.trim().replace(/\s+/g, ' ').slice(0, maxValue) : '';
        const sanitizeUrl = (value) => {
          const candidate = typeof value === 'string' ? value.trim().slice(0, maxUrl) : '';
          if (!candidate) return '';
          try {
            const url = new URL(candidate);
            if (url.protocol !== 'https:' && url.protocol !== 'http:') return '';
            url.username = '';
            url.password = '';
            url.search = '';
            url.hash = '';
            return url.toString().slice(0, maxUrl);
          } catch {
            return '';
          }
        };

        try {
          if (!window.sessionStorage.getItem(storageKey)) {
            const current = new URL(window.location.href);
            window.sessionStorage.setItem(
              storageKey,
              JSON.stringify({
                landingPage: sanitizeUrl(current.toString()),
                referrer: sanitizeUrl(document.referrer),
                utmSource: clean(current.searchParams.get('utm_source')),
                utmMedium: clean(current.searchParams.get('utm_medium')),
                utmCampaign: clean(current.searchParams.get('utm_campaign')),
                utmContent: clean(current.searchParams.get('utm_content')),
                utmTerm: clean(current.searchParams.get('utm_term')),
              }),
            );
          }
        } catch {
          // Attribution is optional and must never block rendering or navigation.
        }

        const emit = (event) => {
          const detail = Object.freeze(event);
          window.dispatchEvent(new CustomEvent('sp:growth-event', { detail }));
          window.dispatchEvent(new CustomEvent(`sp:${event.name}`, { detail }));
        };

        document.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          const anchor = target.closest('a[href]');
          if (!(anchor instanceof HTMLAnchorElement)) return;
          const href = anchor.getAttribute('href')?.trim().toLowerCase() ?? '';
          if (href.startsWith('tel:')) {
            emit({ name: 'contact_selected', channel: 'phone' });
            return;
          }
          if (href.startsWith('mailto:')) emit({ name: 'contact_selected', channel: 'email' });
        });
      })();
    </script>
  </body>
</html>
