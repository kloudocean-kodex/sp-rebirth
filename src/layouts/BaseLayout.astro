---
import '@/styles/global.css';
import '@/styles/brand.css';
import { SITE } from '@/config/site';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  image?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  bodyClass?: string;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  image = SITE.defaultOgImage,
  noindex = false,
  schema,
  bodyClass = '',
} = Astro.props;

const site = Astro.site ?? new URL(SITE.url);
const canonical = new URL(canonicalPath, site);
const ogImage = new URL(image, site);
const isProduction = import.meta.env.PUBLIC_DEPLOY_ENV === 'production';
const effectiveNoindex = noindex || !isProduction;
const defaultSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: site.toString(),
  telephone: SITE.phone.schema,
  email: SITE.email,
};
const schemaPayload = schema ?? defaultSchema;
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#151612" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {effectiveNoindex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaPayload)} />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot name="header" />
    <main id="main-content">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
