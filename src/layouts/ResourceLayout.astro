---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import InnerHero from '@/components/InnerHero.astro';
import { SITE } from '@/config/site';

interface SourceLink {
  label: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  eyebrow: string;
  heading: string;
  lead: string;
  reviewedOn: string;
  reviewedOnIso: string;
  sources: SourceLink[];
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  eyebrow,
  heading,
  lead,
  reviewedOn,
  reviewedOnIso,
  sources,
  image,
  noindex = true,
} = Astro.props;

if (!/^\d{4}-\d{2}-\d{2}$/.test(reviewedOnIso)) {
  throw new Error(`Resource review date must use YYYY-MM-DD: ${reviewedOnIso}`);
}

const pageUrl = new URL(canonicalPath, Astro.site ?? SITE.url).toString();
const publisher = {
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
};
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: heading,
  description,
  url: pageUrl,
  mainEntityOfPage: pageUrl,
  dateModified: reviewedOnIso,
  author: publisher,
  publisher,
};
---

<BaseLayout {title} {description} {canonicalPath} {noindex} {schema}>
  <SiteHeader slot="header" />
  {
    image ? (
      <InnerHero {eyebrow} title={heading} {lead} image={image} />
    ) : (
      <InnerHero {eyebrow} title={heading} {lead} />
    )
  }

  <section class="resource-meta">
    <div class="container resource-meta__inner">
      <div>
        <span>Last reviewed</span>
        <strong>{reviewedOn}</strong>
      </div>
      <p>
        General information only. Victorian rental rules can change; use the linked government sources to check the
        requirements that apply to your property and circumstances.
      </p>
    </div>
  </section>

  <article class="resource-article container">
    <slot />
  </article>

  <section class="source-panel">
    <div class="container source-panel__inner">
      <div>
        <p class="eyebrow">Authoritative sources</p>
        <h2>Check the current rule at the source.</h2>
      </div>
      <ul>
        {
          sources.map((source) => (
            <li>
              <a href={source.href} target="_blank" rel="noopener noreferrer">
                {source.label} ↗
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container cta-panel">
      <div>
        <p class="eyebrow">Your property · your context</p>
        <h2>Need to talk through the practical next step?</h2>
        <p>
          General information is useful, but the right management decision depends on the property, tenancy and current
          circumstances.
        </p>
      </div>
      <div class="cta-panel__actions">
        <a class="button button--solid" href="/rental-appraisal/">Rental appraisal</a>
        <a class="button" href="/contact/">Talk to Sana</a>
      </div>
    </div>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .resource-meta {
    background: var(--paper-deep);
    border-bottom: 1px solid var(--line);
  }
  .resource-meta__inner {
    padding-block: 1.25rem;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-4);
    align-items: center;
  }
  .resource-meta__inner > div {
    display: grid;
    gap: 0.15rem;
  }
  .resource-meta span {
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .resource-meta strong {
    font-size: 0.95rem;
  }
  .resource-meta p {
    max-width: 52rem;
    color: var(--ink-soft);
    font-size: 0.88rem;
  }
  .resource-article {
    padding-block: var(--space-6);
    max-width: min(100% - 2rem, 52rem);
  }
  .resource-article :global(h2) {
    margin-top: var(--space-5);
    font-size: clamp(1.8rem, 3vw, 3rem);
    max-width: 19ch;
  }
  .resource-article :global(p),
  .resource-article :global(li) {
    color: var(--ink-soft);
    font-size: 1.03rem;
    line-height: 1.72;
  }
  .resource-article :global(p) {
    margin-top: var(--space-2);
  }
  .resource-article :global(ul),
  .resource-article :global(ol) {
    margin: var(--space-2) 0 0 1.2rem;
    display: grid;
    gap: 0.65rem;
  }
  .resource-article :global(.note) {
    padding: 1.15rem 1.25rem;
    border-left: 4px solid var(--accent);
    background: var(--paper-deep);
    color: var(--ink);
  }
  .source-panel {
    padding-block: var(--space-5);
    background: var(--ink);
    color: var(--white);
  }
  .source-panel__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-5);
  }
  .source-panel h2 {
    margin-top: var(--space-2);
    max-width: 12ch;
    font-size: var(--h2);
  }
  .source-panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }
  .source-panel li {
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
  }
  .source-panel a {
    display: block;
    min-height: 3.4rem;
    padding: 1rem 0;
    color: var(--white);
    font-weight: 650;
  }
  @media (max-width: 760px) {
    .resource-meta__inner,
    .source-panel__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
