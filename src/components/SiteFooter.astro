---
import { SITE } from '@/config/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container-wide">
    <div class="footer-grid">
      <div>
        <p class="eyebrow">{SITE.name}</p>
        <h2>Your property deserves clear accountability.</h2>
      </div>
      <div>
        <p><strong>Talk to Sana</strong></p>
        <p><a href={`tel:${SITE.phone.e164}`}>{SITE.phone.display}</a></p>
        <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      </div>
      <div>
        <p><strong>Explore</strong></p>
        <p><a href="/rental-appraisal/">Rental appraisal</a></p>
        <p><a href="/switch-property-managers/">Switch property managers</a></p>
        <p><a href="/privacy/">Privacy</a></p>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} {SITE.name}.</span>
      <span>Melbourne, Victoria · Strategy and digital platform by ProddyG</span>
    </div>
  </div>
</footer>
