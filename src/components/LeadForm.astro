---
interface Props {
  type: 'rental_appraisal' | 'switch_manager' | 'general';
  heading?: string;
  submitLabel?: string;
  showCurrentManager?: boolean;
}

const {
  type,
  heading = 'Tell Sana about your property',
  submitLabel = 'Send enquiry',
  showCurrentManager = false,
} = Astro.props;

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const privacyNoticeVersion = '2026-08-27';
---
<div class="lead-form-shell">
  <div class="lead-form-intro">
    <p class="eyebrow">Private enquiry</p>
    <h2>{heading}</h2>
    <p>Enough information to make the first conversation useful—without turning the form into an application process.</p>
  </div>

  <form class="lead-form" method="post" action="/api/leads" data-lead-form data-form-type={type}>
    <input type="hidden" name="form_type" value={type} />
    <input type="hidden" name="privacy_notice_version" value={privacyNoticeVersion} />
    <input type="hidden" name="landing_page" value="" />
    <input type="hidden" name="referrer" value="" />
    <input type="hidden" name="utm_source" value="" />
    <input type="hidden" name="utm_medium" value="" />
    <input type="hidden" name="utm_campaign" value="" />
    <input type="hidden" name="utm_content" value="" />
    <input type="hidden" name="utm_term" value="" />

    <div class="hp" aria-hidden="true">
      <label>Company website <input type="text" name="company_website" tabindex="-1" autocomplete="off" /></label>
    </div>

    <div class="field-grid field-grid--two">
      <label>
        <span>Full name</span>
        <input name="full_name" type="text" autocomplete="name" maxlength="120" required />
      </label>
      <label>
        <span>Phone</span>
        <input name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="40" required />
      </label>
    </div>

    <label>
      <span>Email</span>
      <input name="email" type="email" autocomplete="email" maxlength="180" required />
    </label>

    {type !== 'general' && (
      <div class="field-grid field-grid--two">
        <label>
          <span>Property address <small>(optional at this stage)</small></span>
          <input name="property_address" type="text" autocomplete="street-address" maxlength="240" />
        </label>
        <label>
          <span>Suburb</span>
          <input name="suburb" type="text" autocomplete="address-level2" maxlength="120" required />
        </label>
      </div>
    )}

    {showCurrentManager && (
      <label>
        <span>Current property manager / agency <small>(optional)</small></span>
        <input name="current_manager" type="text" maxlength="180" />
      </label>
    )}

    <div class="field-grid field-grid--two">
      <label>
        <span>What best describes your situation?</span>
        <select name="situation">
          <option value="">Select one</option>
          <option>Property currently managed</option>
          <option>Self-managed property</option>
          <option>New investment / settlement approaching</option>
          <option>Currently vacant</option>
          <option>Tenanted property</option>
          <option>Just exploring options</option>
        </select>
      </label>
      <label>
        <span>Timing</span>
        <select name="timeframe">
          <option value="">Select one</option>
          <option>As soon as possible</option>
          <option>Within 30 days</option>
          <option>1–3 months</option>
          <option>3+ months</option>
          <option>Not sure yet</option>
        </select>
      </label>
    </div>

    <label>
      <span>Anything Sana should know?</span>
      <textarea name="message" rows="5" maxlength="3000"></textarea>
    </label>

    <div class="collection-notice" role="note">
      <strong>About your information</strong>
      <p>Submitting this form asks Sana Patel Real Estate to contact you about this enquiry. We collect the details above plus limited page, referral and campaign information so Sana can respond and understand how genuine enquiries reach the website. This form does not subscribe you to marketing. Website security, hosting and the final lead/email providers may process the information as described in the <a href="/privacy/">privacy notice</a>.</p>
    </div>

    {turnstileSiteKey ? (
      <div
        class="cf-turnstile"
        data-sitekey={turnstileSiteKey}
        data-action={type}
        data-theme="light"
        data-size="flexible"
        data-refresh-expired="auto"
        data-refresh-timeout="auto"
      ></div>
    ) : (
      <p class="configuration-note" role="note">Staging configuration pending: Cloudflare Turnstile site key.</p>
    )}

    <button class="button button--solid" type="submit">{submitLabel}</button>
    <p class="form-status" aria-live="polite" data-form-status></p>
  </form>
</div>

{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  import { emitGrowthEvent, type LeadJourney } from '@/lib/growth-events';

  type TurnstileApi = { reset: (widget?: HTMLElement | string) => void };
  const forms = document.querySelectorAll('[data-lead-form]');

  for (const form of forms) {
    if (!(form instanceof HTMLFormElement)) continue;

    const params = new URLSearchParams(window.location.search);
    const rawFormType = form.dataset.formType;
    const formType: LeadJourney =
      rawFormType === 'rental_appraisal' || rawFormType === 'switch_manager' || rawFormType === 'general'
        ? rawFormType
        : 'general';

    const set = (name: string, value: string | null) => {
      const field = form.elements.namedItem(name);
      if (field instanceof HTMLInputElement) field.value = value || '';
    };

    set('landing_page', window.location.href.slice(0, 700));
    set('referrer', document.referrer.slice(0, 700));
    for (const key of ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term']) {
      set(key, params.get(key));
    }

    form.addEventListener('input', () => emitGrowthEvent({ name: 'lead_started', formType }), { once: true });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const status = form.querySelector('[data-form-status]');
      const button = form.querySelector('button[type="submit"]');
      if (!(button instanceof HTMLButtonElement)) return;

      button.disabled = true;
      button.setAttribute('aria-busy', 'true');
      if (status) status.textContent = 'Sending securely…';
      emitGrowthEvent({ name: 'lead_submit_attempted', formType });

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { 'x-sp-rebirth-fetch': '1' },
        });
        const result = await response.json();

        if (!response.ok || !result.ok) {
          throw new Error(result?.error || 'submission_failed');
        }

        // The honeypot intentionally returns a success-like 202 without a lead ID.
        // Count only the API's real durable-acceptance contract (201 + lead ID) as
        // lead_accepted so decoy bot submissions cannot inflate conversion signals.
        if (response.status === 201 && typeof result.leadId === 'string' && result.leadId.length > 0) {
          emitGrowthEvent({ name: 'lead_accepted', formType });
        }
        window.location.assign(`/thank-you/?type=${encodeURIComponent(formType)}`);
      } catch {
        emitGrowthEvent({ name: 'lead_failed', formType });
        if (status) status.textContent = 'We could not safely deliver your enquiry. Please call Sana on 0416 977 990 or try again.';

        const widget = form.querySelector('.cf-turnstile');
        const turnstile = (window as Window & { turnstile?: TurnstileApi }).turnstile;
        if (widget instanceof HTMLElement && turnstile) turnstile.reset(widget);

        button.disabled = false;
        button.removeAttribute('aria-busy');
      }
    });
  }
</script>

<style>
  .lead-form-shell { display:grid; grid-template-columns:minmax(0,.75fr) minmax(0,1.25fr); gap:var(--space-5); align-items:start; }
  .lead-form-intro h2 { margin-top:var(--space-2); font-size:var(--h2); max-width:10ch; }
  .lead-form-intro > p:last-child { margin-top:var(--space-2); color:var(--ink-soft); max-width:28rem; }
  .lead-form { display:grid; gap:1.15rem; padding:clamp(1.4rem,3vw,2.5rem); border:1px solid var(--line); border-radius:var(--radius-md); background:var(--white); box-shadow:var(--shadow-soft); }
  .field-grid { display:grid; gap:1rem; }
  .field-grid--two { grid-template-columns:1fr 1fr; }
  label { display:grid; gap:.48rem; }
  label > span { font-size:.74rem; font-weight:700; letter-spacing:.045em; text-transform:uppercase; }
  label small { font-weight:500; opacity:.66; text-transform:none; letter-spacing:0; }
  input, select, textarea { width:100%; border:1px solid rgba(23,23,19,.25); border-radius:var(--radius-sm); background:#fff; color:var(--ink); padding:.85rem .95rem; box-shadow:none; }
  input, select { min-height:3.25rem; }
  textarea { resize:vertical; min-height:9rem; }
  input:focus, select:focus, textarea:focus { border-color:var(--accent-deep); outline:3px solid rgba(109,83,44,.16); outline-offset:1px; }
  .collection-notice { padding:1rem 1.05rem; border-top:1px solid var(--line); border-bottom:1px solid var(--line); color:var(--ink-soft); font-size:.82rem; }
  .collection-notice strong { color:var(--ink); font-size:.76rem; letter-spacing:.04em; text-transform:uppercase; }
  .collection-notice p { margin-top:.35rem; }
  .collection-notice a { color:var(--accent-deep); font-weight:650; }
  .configuration-note { padding:.8rem 1rem; border-left:3px solid var(--accent); background:var(--paper); font-size:.82rem; color:var(--ink-soft); }
  .form-status { min-height:1.5rem; color:var(--danger); font-size:.86rem; }
  .hp { position:absolute !important; left:-10000px !important; width:1px !important; height:1px !important; overflow:hidden !important; }
  button:disabled { opacity:.58; cursor:wait; }
  @media(max-width:850px){ .lead-form-shell,.field-grid--two{grid-template-columns:1fr;} }
</style>
