---
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  image?: string;
  imagePosition?: string;
  imageWidth?: number;
  imageHeight?: number;
}

const {
  eyebrow,
  title,
  lead,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
  image,
  imagePosition,
  imageWidth = 1600,
  imageHeight = 1000,
} = Astro.props;
---
<section class="inner-hero">
  {image && (
    <img
      class="inner-hero__image"
      src={image}
      alt=""
      width={imageWidth}
      height={imageHeight}
      fetchpriority="high"
      style={imagePosition ? `object-position:${imagePosition};` : undefined}
    />
  )}
  <div class="inner-hero__shade"></div>
  <div class="inner-hero__content container-wide">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="inner-hero__lead">{lead}</p>
    {(primaryLabel || secondaryLabel) && (
      <div class="inner-hero__actions">
        {primaryLabel && primaryHref && <a class="button button--solid" href={primaryHref}>{primaryLabel}</a>}
        {secondaryLabel && secondaryHref && <a class="button button--light" href={secondaryHref}>{secondaryLabel}</a>}
      </div>
    )}
  </div>
</section>

<style>
  .inner-hero { position:relative; min-height:72svh; display:grid; align-items:end; overflow:hidden; background:#161712; color:var(--white); }
  .inner-hero__image { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:.58; }
  .inner-hero__shade { position:absolute; inset:0; background:linear-gradient(180deg,rgba(9,10,8,.48),rgba(9,10,8,.18) 35%,rgba(9,10,8,.82)); }
  .inner-hero__content { position:relative; z-index:2; padding-block:10rem clamp(3rem,8vh,6rem); }
  h1 { margin-top:var(--space-2); max-width:13ch; font-size:var(--h1); }
  .inner-hero__lead { margin-top:var(--space-3); max-width:43rem; color:rgba(255,255,255,.78); font-size:var(--body-lg); }
  .inner-hero__actions { margin-top:var(--space-4); display:flex; flex-wrap:wrap; gap:.8rem; }
  @media(max-width:560px){ .inner-hero__actions{flex-direction:column;} }
</style>
