---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  intro?: string;
  items: FAQItem[];
}

const { eyebrow = 'Questions worth asking', heading, intro, items } = Astro.props;
---

<section class="faq-section section" aria-labelledby="faq-heading">
  <div class="container faq-layout">
    <div class="faq-intro">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="faq-heading">{heading}</h2>
      {intro && <p>{intro}</p>}
    </div>

    <div class="faq-list">
      {
        items.map((item, index) => (
          <details class="faq-item">
            <summary>
              <span class="faq-item__number numeric">{String(index + 1).padStart(2, '0')}</span>
              <span>{item.question}</span>
              <span class="faq-item__mark" aria-hidden="true" />
            </summary>
            <div class="faq-item__answer">
              <p>{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-section {
    background: var(--white);
  }
  .faq-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
    gap: var(--space-5);
    align-items: start;
  }
  .faq-intro {
    position: sticky;
    top: 2rem;
  }
  .faq-intro h2 {
    margin-top: var(--space-2);
    max-width: 11ch;
    font-size: var(--h2);
  }
  .faq-intro > p:last-child {
    margin-top: var(--space-3);
    max-width: 32rem;
    color: var(--ink-soft);
  }
  .faq-list {
    border-top: 1px solid var(--line-strong);
  }
  .faq-item {
    border-bottom: 1px solid var(--line);
  }
  .faq-item summary {
    min-height: 5.2rem;
    display: grid;
    grid-template-columns: 2.6rem minmax(0, 1fr) 1.4rem;
    gap: 1rem;
    align-items: center;
    padding: 1.1rem 0;
    cursor: pointer;
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary > span:nth-child(2) {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.9vw, 1.65rem);
    font-weight: 430;
    line-height: 1.18;
    letter-spacing: -0.015em;
  }
  .faq-item__number {
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .faq-item__mark {
    position: relative;
    width: 1rem;
    height: 1rem;
    justify-self: end;
  }
  .faq-item__mark::before,
  .faq-item__mark::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: 1px;
    background: var(--accent);
    transition: transform 180ms ease;
  }
  .faq-item__mark::after {
    transform: rotate(90deg);
  }
  .faq-item[open] .faq-item__mark::after {
    transform: rotate(0);
  }
  .faq-item__answer {
    padding: 0 2.4rem 1.5rem 3.6rem;
  }
  .faq-item__answer p {
    max-width: 42rem;
    color: var(--ink-soft);
  }
  @media (max-width: 820px) {
    .faq-layout {
      grid-template-columns: 1fr;
    }
    .faq-intro {
      position: static;
    }
  }
  @media (max-width: 560px) {
    .faq-item summary {
      grid-template-columns: 2rem minmax(0, 1fr) 1.1rem;
      gap: 0.7rem;
    }
    .faq-item__answer {
      padding-left: 2.7rem;
      padding-right: 0;
    }
  }
</style>
