---
const questions = [
  {
    number: '01',
    title: 'Who owns the next step?',
    ask: 'When something changes, who is responsible for following it through—and how will I know?',
    lookFor:
      'A named point of accountability, a clear escalation path and communication that explains the next decision.',
  },
  {
    number: '02',
    title: 'What evidence sits behind a rent recommendation?',
    ask: 'How will you explain the property’s position against current competition, presentation and timing?',
    lookFor: 'Context behind the number, not only an optimistic headline range.',
  },
  {
    number: '03',
    title: 'How does an inspection become action?',
    ask: 'What will an inspection report show, and what happens when it identifies an issue?',
    lookFor: 'Useful condition evidence, clear follow-up and a visible closure point.',
  },
  {
    number: '04',
    title: 'How are maintenance decisions made visible?',
    ask: 'How will I receive the issue, context, recommendation, cost and outcome when work is needed?',
    lookFor: 'A process that keeps the owner informed without requiring repeated chasing.',
  },
  {
    number: '05',
    title: 'What would a managed transition actually involve?',
    ask: 'Before I change agencies, what needs checking in the current authority, tenancy and handover records?',
    lookFor: 'A considered handover plan—not pressure to cancel before the existing arrangement is understood.',
  },
] as const;
---

<section class="comparison-section" aria-labelledby="comparison-heading">
  <div class="container-wide comparison-section__inner">
    <div class="comparison-section__intro">
      <p class="eyebrow">A better comparison</p>
      <h2 id="comparison-heading">Compare the management, not the marketing.</h2>
      <p>
        “Boutique”, “personal” and “proactive” are easy to promise. These five questions help turn a comparison into
        something you can actually observe before appointing—or changing—an agency.
      </p>
      <p class="comparison-section__source">
        Consumer Affairs Victoria recommends researching agents and speaking with at least two or three in your local
        area. <a
          href="https://www.consumer.vic.gov.au/housing/renting/starting-and-changing-rental-agreements/using-a-property-manager-or-agent"
          target="_blank"
          rel="noopener noreferrer">Read the current guidance ↗</a
        >
      </p>
    </div>

    <ol class="comparison-list">
      {
        questions.map((item) => (
          <li>
            <span class="comparison-list__number">{item.number}</span>
            <div>
              <h3>{item.title}</h3>
              <p class="comparison-list__ask">
                <strong>Ask</strong> {item.ask}
              </p>
              <p>
                <strong>Look for</strong> {item.lookFor}
              </p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="comparison-section__actions">
      <a class="button button--solid" href="/property-management-visibility-check/">Take the private 90-second check</a>
      <a class="button" href="#switch-form">Discuss your situation with Sana</a>
    </div>
  </div>
</section>

<style>
  .comparison-section {
    background: var(--paper-deep);
  }
  .comparison-section__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    column-gap: var(--space-5);
    row-gap: var(--space-4);
    align-items: start;
  }
  .comparison-section__intro h2 {
    margin-top: var(--space-2);
    max-width: 12ch;
    font-size: var(--h2);
  }
  .comparison-section__intro > p:not(.eyebrow) {
    margin-top: var(--space-3);
    max-width: 31rem;
    color: var(--ink-soft);
  }
  .comparison-section__source {
    font-size: 0.84rem;
    line-height: 1.55;
  }
  .comparison-section__source a {
    color: var(--accent-deep);
    font-weight: 700;
  }
  .comparison-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-strong);
  }
  .comparison-list li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: var(--space-2);
    padding: 1.45rem 0;
    border-bottom: 1px solid var(--line);
  }
  .comparison-list__number {
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.08em;
  }
  .comparison-list h3 {
    font-size: clamp(1.35rem, 2vw, 1.75rem);
  }
  .comparison-list p {
    max-width: 46rem;
    margin-top: 0.45rem;
    color: var(--ink-soft);
  }
  .comparison-list p strong {
    color: var(--ink);
    font-size: 0.75rem;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }
  .comparison-list__ask {
    margin-top: 0.75rem;
  }
  .comparison-section__actions {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    padding-top: var(--space-1);
  }
  @media (max-width: 820px) {
    .comparison-section__inner {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .comparison-section__actions {
      display: grid;
    }
    .comparison-section__actions .button {
      width: 100%;
    }
  }
</style>
