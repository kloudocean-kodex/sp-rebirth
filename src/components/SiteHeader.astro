---
const ctaHref = '/rental-appraisal/';
const logoSrc = 'https://www.sanapatel.com.au/wp-content/uploads/2025/07/Sana-Patel-Logo.webp';
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label="Sana Patel Real Estate home">
      <img class="brand__logo" src={logoSrc} alt="Sana Patel Real Estate" width="190" height="55" decoding="async" />
    </a>

    <div class="header-actions">
      <nav class="site-nav site-nav--desktop" aria-label="Primary navigation">
        <a href="/rental-providers/">Rental Providers</a>
        <a href="/switch-property-managers/">Switch Managers</a>
        <a href="/about/">About Sana</a>
        <a href="/resources/">Resources</a>
        <a class="button button--light" href={ctaHref}>Rental Appraisal</a>
      </nav>

      <details class="mobile-nav">
        <summary aria-label="Open navigation menu">
          <span class="mobile-nav__label">Menu</span>
          <span class="mobile-nav__icon" aria-hidden="true"><i></i><i></i></span>
        </summary>
        <nav class="mobile-nav__panel" aria-label="Mobile navigation">
          <a href="/rental-providers/">Rental Providers</a>
          <a href="/rental-appraisal/">Rental Appraisal</a>
          <a href="/rental-position-check/">Rental Position Check</a>
          <a href="/switch-property-managers/">Switch Property Managers</a>
          <a href="/about/">About Sana</a>
          <a href="/resources/">Resources</a>
          <a href="/for-renters/">For Renters</a>
          <a href="/sale/">Selling</a>
          <a href="/contact/">Contact</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .brand {
    padding: 0.5rem 0.72rem;
    border-color: rgba(215, 195, 154, 0.48);
    background: linear-gradient(145deg, rgba(15, 16, 13, 0.97), rgba(27, 27, 22, 0.9));
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.2);
  }
  .brand:hover {
    border-color: rgba(215, 195, 154, 0.82);
    background: linear-gradient(145deg, rgba(18, 19, 16, 0.99), rgba(31, 30, 24, 0.94));
    box-shadow: 0 16px 44px rgba(0, 0, 0, 0.25);
  }
  .site-nav > a:not(.button) {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
  }
  @media (max-width: 900px) {
    .brand {
      padding: 0.42rem 0.58rem;
    }
  }
</style>
