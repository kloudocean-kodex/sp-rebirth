---
import { SITE } from '@/config/site';

const ctaHref = '/rental-appraisal/';
const logoSrc = SITE.logo;
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label="Sana Patel Real Estate home">
      <img class="brand__logo" src={logoSrc} alt="Sana Patel Real Estate" width="190" height="55" decoding="async" />
    </a>

    <div class="header-actions">
      <nav class="site-nav site-nav--desktop" aria-label="Primary navigation">
        <a href="/#services">Services</a>
        <a href="/#why-sana">Why Sana</a>
        <a href="/#reviews">Reviews</a>
        <a class="header-call" href={`tel:${SITE.phone.e164}`}>
          <span>Call Sana</span>
          <strong>{SITE.phone.display}</strong>
        </a>
        <a class="button button--light" href={ctaHref}>Rental Appraisal</a>
      </nav>

      <details class="mobile-nav">
        <summary aria-label="Open navigation menu">
          <span class="mobile-nav__label">Menu</span>
          <span class="mobile-nav__icon" aria-hidden="true"><i></i><i></i></span>
        </summary>
        <nav class="mobile-nav__panel" aria-label="Mobile navigation">
          <a href="/#services">Services</a>
          <a href="/#why-sana">Why Sana</a>
          <a href="/#reviews">Reviews</a>
          <a href="/switch-property-managers/">Switch Property Manager</a>
          <a class="mobile-nav__call" href={`tel:${SITE.phone.e164}`}>Call Sana · {SITE.phone.display}</a>
          <a class="mobile-nav__primary" href={ctaHref}>Request a Rental Appraisal</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    background: rgba(13, 14, 12, 0.965);
    border-bottom: 1px solid rgba(215, 195, 154, 0.24);
    backdrop-filter: blur(16px);
  }
  .site-header__inner {
    min-height: 5.5rem;
    border-bottom: 0;
  }
  .brand {
    padding: 0.46rem 0.66rem;
    border-color: rgba(215, 195, 154, 0.4);
    background: rgba(10, 11, 9, 0.92);
    box-shadow: none;
  }
  .brand:hover {
    border-color: rgba(215, 195, 154, 0.8);
    background: rgba(18, 19, 16, 0.98);
    box-shadow: none;
  }
  .site-nav > a:not(.button) {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
  }
  .header-call {
    display: grid !important;
    align-content: center;
    gap: 0.08rem;
    padding-inline: 0.25rem;
    text-transform: none !important;
  }
  .header-call span {
    color: var(--gold-soft);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .header-call strong {
    color: var(--white);
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.01em;
  }
  .mobile-nav__call,
  .mobile-nav__primary {
    margin: 0.35rem 0.35rem 0;
    border: 1px solid rgba(215, 195, 154, 0.35) !important;
    border-radius: var(--radius-sm);
    text-align: center;
  }
  .mobile-nav__primary {
    background: var(--gold-deep);
    color: var(--white) !important;
  }
  @media (max-width: 1080px) {
    .header-call strong {
      display: none;
    }
  }
  @media (max-width: 900px) {
    .site-header__inner {
      min-height: 5rem;
    }
    .brand {
      padding: 0.42rem 0.58rem;
    }
  }
</style>
