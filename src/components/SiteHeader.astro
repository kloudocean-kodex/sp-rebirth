---
import { SITE } from '@/config/site';
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand brand--original" href="/#top" aria-label="Sana Patel Real Estate home">
      <img
        class="brand__logo"
        src={SITE.logoAsset}
        alt="Sana Patel Real Estate"
        width="190"
        height="55"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </a>

    <div class="header-actions">
      <nav class="site-nav site-nav--desktop" aria-label="Primary navigation">
        <a href="/#pride">PRIDE</a>
        <a href="/#why-sana">Why Sana</a>
        <a href="/#services">Services</a>
        <a href="/#reviews">Reviews</a>
        <a class="header-call" href={`tel:${SITE.phone.e164}`}>
          <span>Call Sana</span>
          <strong>{SITE.phone.display}</strong>
        </a>
        <a class="button button--light" href="/#appraisal">Rental Appraisal</a>
      </nav>

      <details class="mobile-nav">
        <summary aria-label="Open navigation menu">
          <span class="mobile-nav__label">Menu</span>
          <span class="mobile-nav__icon" aria-hidden="true"><i></i><i></i></span>
        </summary>
        <nav class="mobile-nav__panel" aria-label="Mobile navigation">
          <a href="/#pride">PRIDE</a>
          <a href="/#why-sana">Why Sana</a>
          <a href="/#services">Services</a>
          <a href="/#reviews">Reviews</a>
          <a href="/#switching">Switch Property Manager</a>
          <a class="mobile-nav__call" href={`tel:${SITE.phone.e164}`}>Call Sana · {SITE.phone.display}</a>
          <a class="mobile-nav__primary" href="/#appraisal">Request a Rental Appraisal</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    background: rgba(13, 14, 12, 0.965);
    border-bottom: 1px solid rgba(215, 195, 154, 0.24);
    backdrop-filter: blur(16px);
  }
  .site-header__inner {
    min-height: 5.5rem;
    border-bottom: 0;
  }
  .brand--original {
    display: inline-flex;
    align-items: center;
    min-height: 3.45rem;
    padding: 0.34rem 0.62rem;
    border: 1px solid rgba(215, 195, 154, 0.34);
    border-radius: var(--radius-sm);
    background: #fffdf8;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.16);
  }
  .brand--original:hover {
    border-color: rgba(215, 195, 154, 0.9);
    box-shadow: 0 10px 34px rgba(0, 0, 0, 0.22);
  }
  .brand__logo {
    width: auto;
    height: 2.6rem;
    max-width: 11.25rem;
    object-fit: contain;
  }
  .site-nav > a:not(.button) {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
  }
  .header-call {
    display: grid !important;
    align-content: center;
    gap: 0.08rem;
    padding-inline: 0.25rem;
    text-transform: none !important;
  }
  .header-call span {
    color: var(--gold-soft);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .header-call strong {
    color: var(--white);
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.01em;
  }
  .mobile-nav__call,
  .mobile-nav__primary {
    margin: 0.35rem 0.35rem 0;
    border: 1px solid rgba(215, 195, 154, 0.35) !important;
    border-radius: var(--radius-sm);
    text-align: center;
  }
  .mobile-nav__primary {
    background: var(--gold-deep);
    color: var(--white) !important;
  }
  @media (max-width: 1080px) {
    .header-call strong {
      display: none;
    }
  }
  @media (max-width: 900px) {
    .site-header__inner {
      min-height: 5rem;
    }
    .brand--original {
      min-height: 3.1rem;
      padding: 0.3rem 0.48rem;
    }
    .brand__logo {
      height: 2.25rem;
      max-width: 9.5rem;
    }
  }
</style>
