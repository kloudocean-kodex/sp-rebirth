---
import { SITE } from '@/config/site';

const ctaHref = '/rental-appraisal/';
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand brand--rebirth" href="/" aria-label="Sana Patel Real Estate home">
      <span class="brand__monogram" aria-hidden="true">SP</span>
      <span class="brand__wordmark" aria-hidden="true">
        <strong>Sana Patel</strong>
        <span>Real Estate</span>
      </span>
    </a>

    <div class="header-actions">
      <nav class="site-nav site-nav--desktop" aria-label="Primary navigation">
        <a href="/#services">Services</a>
        <a href="/#why-sana">Why Sana</a>
        <a href="/#reviews">Reviews</a>
        <a class="header-call" href={`tel:${SITE.phone.e164}`}>
          <span>Call Sana</span>
          <strong>{SITE.phone.display}</strong>
        </a>
        <a class="button button--light" href={ctaHref}>Rental Appraisal</a>
      </nav>

      <details class="mobile-nav">
        <summary aria-label="Open navigation menu">
          <span class="mobile-nav__label">Menu</span>
          <span class="mobile-nav__icon" aria-hidden="true"><i></i><i></i></span>
        </summary>
        <nav class="mobile-nav__panel" aria-label="Mobile navigation">
          <a href="/#services">Services</a>
          <a href="/#why-sana">Why Sana</a>
          <a href="/#reviews">Reviews</a>
          <a href="/switch-property-managers/">Switch Property Manager</a>
          <a class="mobile-nav__call" href={`tel:${SITE.phone.e164}`}>Call Sana · {SITE.phone.display}</a>
          <a class="mobile-nav__primary" href={ctaHref}>Request a Rental Appraisal</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    background: rgba(13, 14, 12, 0.965);
    border-bottom: 1px solid rgba(215, 195, 154, 0.24);
    backdrop-filter: blur(16px);
  }
  .site-header__inner {
    min-height: 5.5rem;
    border-bottom: 0;
  }
  .brand {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    gap: 0.68rem;
    padding: 0.42rem 0.7rem 0.42rem 0.48rem;
    border: 1px solid rgba(215, 195, 154, 0.48);
    border-radius: var(--radius-sm);
    background: rgba(8, 9, 7, 0.96);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.16);
  }
  .brand:hover {
    border-color: rgba(215, 195, 154, 0.86);
    background: rgba(18, 19, 16, 0.99);
    box-shadow: 0 10px 34px rgba(0, 0, 0, 0.2);
  }
  .brand__monogram {
    width: 2.55rem;
    height: 2.55rem;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    margin: 0;
    border: 1px solid rgba(215, 195, 154, 0.52);
    border-radius: 999px;
    color: var(--gold-soft);
    font-family: var(--font-display);
    font-size: 1.24rem;
    font-weight: 430;
    letter-spacing: -0.035em;
    line-height: 1;
    text-transform: none;
    opacity: 1;
  }
  .brand__wordmark {
    display: grid;
    gap: 0.16rem;
    margin: 0;
    color: var(--white);
    line-height: 1;
    text-transform: none;
    opacity: 1;
  }
  .brand__wordmark strong {
    color: var(--white);
    font-family: var(--font-display);
    font-size: 1.04rem;
    font-weight: 440;
    letter-spacing: 0;
    line-height: 1;
  }
  .brand__wordmark > span {
    margin: 0;
    color: rgba(255, 253, 248, 0.72);
    font-size: 0.52rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    line-height: 1;
    text-transform: uppercase;
    opacity: 1;
  }
  .site-nav > a:not(.button) {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
  }
  .header-call {
    display: grid !important;
    align-content: center;
    gap: 0.08rem;
    padding-inline: 0.25rem;
    text-transform: none !important;
  }
  .header-call span {
    color: var(--gold-soft);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .header-call strong {
    color: var(--white);
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.01em;
  }
  .mobile-nav__call,
  .mobile-nav__primary {
    margin: 0.35rem 0.35rem 0;
    border: 1px solid rgba(215, 195, 154, 0.35) !important;
    border-radius: var(--radius-sm);
    text-align: center;
  }
  .mobile-nav__primary {
    background: var(--gold-deep);
    color: var(--white) !important;
  }
  @media (max-width: 1080px) {
    .header-call strong {
      display: none;
    }
  }
  @media (max-width: 900px) {
    .site-header__inner {
      min-height: 5rem;
    }
    .brand {
      gap: 0.56rem;
      padding: 0.36rem 0.56rem 0.36rem 0.4rem;
    }
    .brand__monogram {
      width: 2.25rem;
      height: 2.25rem;
      font-size: 1.08rem;
    }
    .brand__wordmark strong {
      font-size: 0.94rem;
    }
    .brand__wordmark > span {
      font-size: 0.48rem;
      letter-spacing: 0.16em;
    }
  }
</style>
