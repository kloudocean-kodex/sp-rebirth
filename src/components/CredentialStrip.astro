---
interface Item {
  label: string;
  value: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<section class="credential-strip" aria-label="Professional credentials">
  <div class="container-wide credential-strip__inner">
    {
      items.map((item) => (
        <div class="credential-strip__item">
          <span>{item.label}</span>
          <strong>{item.value}</strong>
        </div>
      ))
    }
  </div>
</section>

<style>
  .credential-strip {
    background: var(--ink);
    color: var(--white);
    border-top: 1px solid rgba(215, 195, 154, 0.28);
    border-bottom: 1px solid rgba(215, 195, 154, 0.18);
  }
  .credential-strip__inner {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .credential-strip__item {
    min-height: 6.35rem;
    padding: 1.15rem var(--space-3);
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-right: 1px solid rgba(255, 255, 255, 0.11);
  }
  .credential-strip__item:first-child {
    border-left: 1px solid rgba(255, 255, 255, 0.11);
  }
  .credential-strip__item span {
    color: var(--gold-soft);
    font-size: 0.61rem;
    font-weight: 700;
    letter-spacing: 0.065em;
    text-transform: uppercase;
  }
  .credential-strip__item strong {
    margin-top: 0.32rem;
    font-family: var(--font-sans);
    font-size: clamp(0.95rem, 1.35vw, 1.16rem);
    font-weight: 620;
    letter-spacing: -0.016em;
    line-height: 1.18;
  }
  @media (max-width: 820px) {
    .credential-strip__inner {
      grid-template-columns: 1fr 1fr;
    }
    .credential-strip__item {
      min-height: 5.2rem;
      padding: 0.9rem 1rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.09);
    }
    .credential-strip__item:nth-child(3) {
      border-left: 1px solid rgba(255, 255, 255, 0.11);
    }
  }
  @media (max-width: 420px) {
    .credential-strip__item {
      min-height: 4.9rem;
      padding-inline: 0.78rem;
    }
    .credential-strip__item span {
      font-size: 0.56rem;
    }
    .credential-strip__item strong {
      font-size: 0.9rem;
    }
  }
</style>
