---
interface Item {
  label: string;
  value: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---
<section class="credential-strip" aria-label="Professional credentials">
  <div class="container-wide credential-strip__inner">
    {items.map((item) => (
      <div class="credential-strip__item">
        <span>{item.label}</span>
        <strong>{item.value}</strong>
      </div>
    ))}
  </div>
</section>

<style>
  .credential-strip { background:var(--ink); color:var(--white); border-top:1px solid rgba(215,195,154,.28); border-bottom:1px solid rgba(215,195,154,.18); }
  .credential-strip__inner { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); }
  .credential-strip__item { min-height:7.8rem; padding:1.55rem var(--space-3); display:flex; flex-direction:column; justify-content:center; border-right:1px solid rgba(255,255,255,.11); }
  .credential-strip__item:first-child { border-left:1px solid rgba(255,255,255,.11); }
  .credential-strip__item span { color:var(--gold-soft); font-size:.67rem; font-weight:700; letter-spacing:.065em; text-transform:uppercase; }
  .credential-strip__item strong { margin-top:.45rem; font-family:var(--font-display); font-size:clamp(1.2rem,1.9vw,1.65rem); font-weight:400; letter-spacing:-.015em; line-height:1.12; }
  @media(max-width:820px){ .credential-strip__inner{grid-template-columns:1fr 1fr;} .credential-strip__item:nth-child(3){border-left:1px solid rgba(255,255,255,.11);} }
  @media(max-width:520px){ .credential-strip__inner{grid-template-columns:1fr;} .credential-strip__item{min-height:6.3rem;border-left:1px solid rgba(255,255,255,.11);} }
</style>
