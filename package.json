{
  "name": "sp-rebirth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/a11y",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.3",
    "@astrojs/react": "^4.4.0",
    "@sanity/astro": "^4.0.0",
    "@sanity/image-url": "^1.2.0",
    "@sanity/presentation": "^1.0.0",
    "@sanity/visual-editing": "^5.7.3",
    "astro": "^7.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanity": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.68.0"
  }
}
