{
  "name": "sp-rebirth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "studio"
  ],
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.8"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:studio": "npm --workspace studio run dev",
    "build": "astro check && astro build",
    "build:studio": "npm --workspace studio run build",
    "preview": "wrangler dev",
    "deploy": "npm run build:production && wrangler deploy --experimental-provision=false --experimental-auto-create=false",
    "build:staging": "node scripts/build-staging.mjs",
    "build:production": "node scripts/build-production.mjs",
    "deploy:staging": "npm run build:staging && wrangler deploy dist/server/entry.mjs --config wrangler.jsonc --env staging --experimental-provision=false --experimental-auto-create=false",
    "deploy:production": "npm run deploy",
    "deploy:preview": "wrangler versions upload --experimental-provision=false --experimental-auto-create=false",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "cf-typegen": "wrangler types"
  },
  "overrides": {
    "@vercel/frameworks": {
      "js-yaml": "3.15.1",
      "smol-toml": "1.6.1"
    },
    "typeid-js": {
      "uuid": "11.1.1"
    }
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.3",
    "@astrojs/react": "^6.0.4",
    "@portabletext/types": "^4.0.2",
    "@sanity/astro": "^3.5.0",
    "@sanity/client": "^7.26.2",
    "@sanity/image-url": "^1.1.0",
    "@sanity/preview-url-secret": "^4.1.5",
    "@sanity/visual-editing": "^6.1.1",
    "astro": "^7.2.7",
    "astro-portabletext": "^0.11.1",
    "groq": "^6.11.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^9.0.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^16.5.0",
    "prettier": "^3.0.0",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.68.0"
  }
}
